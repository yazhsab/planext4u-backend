{
  "name": "@planext4u/admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture-api": "node e2e/fixture-api.mjs",
    "build": "npm run generate:api && tsc -b && vite build",
    "generate:api": "openapi-typescript ../api/openapi/admin.openapi.json -o src/api/schema.gen.ts",
    "typecheck": "npm run generate:api && tsc -b --pretty false",
    "lint": "eslint src 'e2e/**/*.ts' vite.config.ts vitest.config.ts playwright.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/node": "26.4.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
