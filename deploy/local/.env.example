# Optional host-port overrides. Values are intentionally non-secret local defaults.
PLANEXT4U_LOCAL_POSTGRES_PORT=54320
PLANEXT4U_LOCAL_REDIS_PORT=63790
PLANEXT4U_LOCAL_NATS_PORT=42220
PLANEXT4U_LOCAL_NATS_MONITOR_PORT=48222
PLANEXT4U_LOCAL_OBJECT_PORT=9000
PLANEXT4U_LOCAL_OBJECT_CONSOLE_PORT=9001
PLANEXT4U_LOCAL_PROVIDER_PORT=18081
# Runtime processes use separate synthetic login credentials. The local role
# bootstrap grants these logins only their matching NOLOGIN runtime role.
PLANEXT4U_LOCAL_IDENTITY_PASSWORD=local-identity-only
PLANEXT4U_LOCAL_CONFIGURATION_PASSWORD=local-configuration-only
PLANEXT4U_LOCAL_CATALOG_PASSWORD=local-catalog-only
PLANEXT4U_LOCAL_MEDIA_PASSWORD=local-media-only
PLANEXT4U_LOCAL_AUDIT_PASSWORD=local-audit-only
PLANEXT4U_LOCAL_MESSAGING_PASSWORD=local-messaging-only
PLANEXT4U_LOCAL_NOTIFICATION_PASSWORD=local-notification-only
