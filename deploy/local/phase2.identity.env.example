# Optional concrete identity mode. Keep the synthetic local stack isolated.
# Mount the credential file privately; never place its contents in this file.
IDENTITY_PROVIDER_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_TENANT_ID=
FIREBASE_CREDENTIALS_FILE=
# Optional contact matching. Configure only with real Firebase phone credentials.
# Mount a separate private 32-64-byte HMAC key file. Rotate the key and ID
# together; old snapshots then require a new explicit user sync.
CONTACT_MATCHING_HMAC_KEY_FILE=
CONTACT_MATCHING_KEY_ID=v1
CONTACT_MATCHING_SNAPSHOT_TTL=24h
CONTACT_MATCHING_MAX_CONTACTS=10000
# admin also requires the deployment's platform TENANT_ID.
# Provision admin.operator_accounts with a verified provider UID and server roles.
# Enroll TOTP in the provider before using the administrator sign-in screen.
# transaction: private owner-service endpoint, never a client-selected URL.
# Leave empty when media is unavailable; document submission/approval returns 503.
# The local container launcher now sets this to http://media:8087.
PRIVATE_MEDIA_BASE_URL=
# media: privately mounted socket, no public clamd TCP listener.
MALWARE_SCANNER_MODE=clamav
CLAMAV_SOCKET=/run/clamav/clamd.sock
# Optional root endpoint used by the public signing client; HTTPS in deployment.
# Match the public PRIVATE_UPLOAD_ORIGIN compiled into the Android apps.
S3_PUBLIC_ENDPOINT=
# transaction: a trusted provider bridge resolving existing bank verification.
# Both values are required together. HTTPS is mandatory outside development.
# The bridge must not initiate a transfer or paid verification during resolve.
BANK_VERIFICATION_BASE_URL=
BANK_VERIFICATION_TOKEN_FILE=
