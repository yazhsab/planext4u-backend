.DS_Store
.idea/
.vscode/
bin/
coverage/
node_modules/
admin-web/dist/
admin-web/playwright-report/
admin-web/test-results/
admin-web/*.tsbuildinfo
*.coverprofile
*.log
.local/

# Terraform providers and local state are never source artifacts. Dependency
# lock files remain committed for reproducible provider selection.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files may contain secrets and must never be committed.
.env
.env.*
!.env.example
