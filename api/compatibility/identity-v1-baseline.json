    "DataExport": [
      "generated_at",
      "identity_id",
      "tenant_id",
      "country",
      "roles",
      "profile",
      "sessions",
      "consents"
    ],
    "DeletionRequest": [
      "id",
      "identity_id",
      "status",
      "requested_at",
      "effective_at"
    ]
  },
  "enum_values": {
    "Role": [
      "CUSTOMER",
      "GUEST",
      "VENDOR",
      "RIDER",
      "ADMIN"
