{
  "operations": [
    {
      "method": "POST",
      "path": "/internal/v1/customer-guest-sessions"
    },
    {
      "method": "POST",
      "path": "/v1/auth/exchange"
    },
    {
      "method": "POST",
      "path": "/v1/auth/refresh"
    },
    {
      "method": "POST",
      "path": "/v1/auth/revoke"
    },
    {
      "method": "GET",
      "path": "/v1/me"
    },
    {
      "method": "PATCH",
      "path": "/v1/me"
    },
    {
      "method": "GET",
      "path": "/v1/me/sessions"
    },
    {
      "method": "DELETE",
      "path": "/v1/me/sessions/{session_id}"
    },
    {
      "method": "GET",
      "path": "/v1/me/consents"
    },
    {
      "method": "PUT",
      "path": "/v1/me/consents/{purpose}"
