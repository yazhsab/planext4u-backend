    ],
    "GuestSession": [
      "session_id",
      "tenant_id",
      "country",
      "access_token",
      "access_expires_at",
      "token_type"
    ],
    "TokenPair": [
      "access_token",
      "access_expires_at",
      "refresh_token",
      "refresh_expires_at",
      "token_type"
    ],
    "Authentication": [
      "identity_id",
      "tenant_id",
      "country",
      "tokens",
      "profile",
      "roles",
      "session"
    ],
    "Profile": [
      "display_name",
      "locale",
      "time_zone",
      "version",
      "updated_at"
    ],
    "Session": [
      "id",
      "device_reference",
      "country",
      "authenticated_at",
      "last_seen_at",
      "expires_at",
      "current"
