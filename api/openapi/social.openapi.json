            "type": "string"
          },
          "media_job_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "author",
          "kind",
          "media_job_id",
          "caption",
          "status",
          "highlighted",
          "expires_at",
          "allowed_actions",
          "created_at"
        ],
        "type": "object"
      },
      "SocialMediaJob": {
        "additionalProperties": false,
        "properties": {
          "appeal_status": {
            "type": "string"
          },
          "asset_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "blur_status": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "moderated_by": {
            "type": "string"
          },
          "owner_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "retention_until": {
            "format": "date-time",
            "type": "string"
          },
          "scan_status": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SocialMediaState"
          },
          "transcode_status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_id",
          "asset_id",
          "kind",
          "state",
          "scan_status",
          "blur_status",
          "transcode_status",
          "retention_until",
          "created_at"
        ],
        "type": "object"
      },
      "SocialMediaState": {
        "enum": [
          "QUARANTINED",
          "READY",
          "REJECTED",
          "TOMBSTONED"
        ],
        "type": "string"
      },
      "SocialPost": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "author": {
            "$ref": "#/components/schemas/SocialProfile"
          },
          "body": {
            "maxLength": 5000,
            "type": "string"
          },
          "comment_count": {
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "hashtags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "like_count": {
            "type": "integer"
          },
          "liked": {
            "type": "boolean"
          },
          "media_asset_ids": {
            "items": {
              "type": "string",
              "x-planext4u-sensitive": true
            },
            "maxItems": 10,
            "type": "array"
          },
          "mentions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "moderation_reason": {
            "type": "string"
          },
          "product_sticker_id": {
            "type": "string"
          },
          "ranking_version": {
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "saved": {
            "type": "boolean"
          },
          "share_count": {
            "type": "integer"
          },
          "sponsor_label": {
            "type": "string"
          },
          "sponsored": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/SocialPostStatus"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "author",
          "body",
          "media_asset_ids",
          "hashtags",
          "mentions",
          "sponsored",
          "status",
          "like_count",
          "comment_count",
          "share_count",
          "liked",
          "saved",
          "allowed_actions",
          "ranking_version",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SocialPostStatus": {
        "enum": [
          "PUBLISHED",
          "PENDING_REVIEW",
          "REMOVED"
        ],
        "type": "string"
      },
      "SocialProfile": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "avatar_asset_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "bio": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "follower_count": {
            "type": "integer"
          },
          "following_count": {
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "relationship": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "handle",
          "display_name",
          "private",
          "verified",
          "follower_count",
          "following_count",
          "relationship",
          "allowed_actions",
          "bio"
        ],
        "type": "object"
      },
      "SocialReport": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "decision_note": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "id": {
            "type": "string"
          },
          "post_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "reporter_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "status": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "post_id",
          "reporter_id",
          "reason",
          "status",
          "created_at",
          "updated_at",
          "details"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Socio API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/moderation/media/{media_id}/appeal-decision": {
      "post": {
        "operationId": "decideSocialMediaAppeal",
        "parameters": [
          {
            "$ref": "#/components/parameters/MediaID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocialMediaJob"
                }
              }
            },
            "description": "Independent appeal decision"
          }
        },
        "x-planext4u-four-eyes-required": true,
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/moderation/media/{media_id}/process": {
      "post": {
        "operationId": "processSocialMedia",
        "parameters": [
          {
            "$ref": "#/components/parameters/MediaID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocialMediaJob"
                }
              }
            },
            "description": "Scan, blur and transcode decision"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/moderation/reports": {
      "get": {
        "operationId": "listModerationReports",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/SocialReport"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "MFA-scoped moderation queue"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/moderation/reports/{report_id}/decision": {
      "post": {
        "operationId": "decideModerationReport",
        "parameters": [
          {
            "$ref": "#/components/parameters/ReportID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocialReport"
                }
              }
            },
            "description": "Auditable moderation decision"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/moderation/retention/purge": {
      "post": {
        "operationId": "purgeSocialRetention",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "purged": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "purged"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Expired content tombstoned"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/social/calls/{call_id}/signals": {
      "post": {
        "operationId": "signalSocialCall",
        "parameters": [
          {
            "$ref": "#/components/parameters/CallID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallSession"
                }
              }
            },
            "description": "Opaque WebRTC signal accepted"
          }
        }
      }
    },
    "/v1/social/collections": {
      "post": {
        "operationId": "createSocialCollection",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            },
            "description": "Created collection"
          }
        }
      }
    },
    "/v1/social/collections/{collection_id}/posts": {
      "put": {
        "operationId": "setSocialCollectionPost",
        "parameters": [
          {
            "$ref": "#/components/parameters/CollectionID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            },
            "description": "Updated collection"
          }
        }
      }
    },
    "/v1/social/conversations": {
      "get": {
        "operationId": "listSocialConversations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/SocialConversation"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Authorized conversations"
          }
        }
      },
      "post": {
        "operationId": "openSocialConversation",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SocialConversation"
                }
              }
            },
            "description": "Conversation or message request"
          }
        }
      }
    },
    "/v1/social/conversations/{conversation_id}/accept": {
      "post": {
        "operationId": "acceptSocialConversation",
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
