          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "author": {
            "$ref": "#/components/schemas/SocialProfile"
          },
          "body": {
            "maxLength": 1000,
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "depth": {
            "maximum": 2,
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "mentions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parent_id": {
            "type": "string"
          },
          "post_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "post_id",
          "depth",
          "author",
          "body",
          "mentions",
          "status",
          "allowed_actions",
          "created_at"
        ],
        "type": "object"
      },
      "SocialConversation": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "participant_ids": {
            "items": {
              "type": "string",
              "x-planext4u-sensitive": true
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "requested_by": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "status": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "participant_ids",
          "status",
          "requested_by",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SocialDirectMessage": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string",
