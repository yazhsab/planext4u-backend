          },
          "status": {
            "type": "string"
          },
          "voice_media_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          }
        },
        "required": [
          "id",
          "conversation_id",
          "sender_id",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "SocialEphemeral": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "author": {
            "$ref": "#/components/schemas/SocialProfile"
          },
          "caption": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "highlighted": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
