          },
          "product_sticker_id": {
            "type": "string"
          }
        },
        "required": [
          "body",
          "media_asset_ids"
        ],
        "type": "object"
      },
      "FeedPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SocialPost"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": "string"
          },
          "ranking_version": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "ranking_version"
        ],
        "type": "object"
      },
      "Follow": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
