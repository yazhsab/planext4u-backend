          },
          "id": {
            "type": "string"
          },
          "initiator_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "signal_count": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "conversation_id",
          "created_at",
          "expires_at",
          "id",
          "initiator_id",
          "kind",
          "signal_count",
          "status"
