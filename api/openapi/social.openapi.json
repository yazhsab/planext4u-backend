            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "expires_at",
          "profile_id",
          "state"
        ],
        "type": "object"
      },
      "ShareSocialPostRequest": {
        "additionalProperties": false,
