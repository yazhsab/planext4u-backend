{
  "components": {
    "parameters": {
      "CallID": {
        "in": "path",
        "name": "call_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "CollectionID": {
        "in": "path",
        "name": "collection_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "ContentID": {
        "in": "path",
        "name": "content_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "ConversationID": {
        "in": "path",
        "name": "conversation_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "FollowerID": {
        "in": "path",
        "name": "follower_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "MediaID": {
        "in": "path",
        "name": "media_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "PostID": {
        "in": "path",
        "name": "post_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "ProfileID": {
        "in": "path",
        "name": "profile_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "ReportID": {
        "in": "path",
        "name": "report_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "schemas": {
      "CallSession": {
