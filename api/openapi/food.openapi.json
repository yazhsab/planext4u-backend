{
  "components": {
    "parameters": {
      "OrderID": {
        "in": "path",
        "name": "order_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RestaurantID": {
        "in": "path",
        "name": "restaurant_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "CartLine": {
        "additionalProperties": false,
        "properties": {
          "line_total": {
            "$ref": "#/components/schemas/Money"
          },
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/PricedOption"
            },
            "type": "array"
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "line_total",
          "menu_item_id",
          "name",
          "options",
          "quantity",
          "unit_price"
        ],
        "type": "object"
      },
      "FoodCart": {
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "delivery_fee": {
            "$ref": "#/components/schemas/Money"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/CartLine"
            },
            "type": "array"
          },
          "postal_code": {
            "type": "string"
          },
          "pricing_version": {
            "type": "string"
          },
          "restaurant": {
            "$ref": "#/components/schemas/Restaurant"
          },
          "revision": {
            "type": "integer"
          },
          "subtotal": {
            "$ref": "#/components/schemas/Money"
          },
          "tax": {
            "$ref": "#/components/schemas/Money"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer_id",
          "restaurant",
          "revision",
          "lines",
          "subtotal",
          "delivery_fee",
          "tax",
          "total",
          "pricing_version",
          "expires_at",
          "postal_code",
          "updated_at"
        ],
        "type": "object"
      },
      "FoodCartLineRequest": {
        "additionalProperties": false,
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "note": {
            "maxLength": 240,
            "type": "string"
          },
          "option_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "quantity": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "menu_item_id",
          "quantity",
          "option_ids"
        ],
        "type": "object"
      },
      "FoodCartRequest": {
        "additionalProperties": false,
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/FoodCartLineRequest"
            },
            "minItems": 1,
            "type": "array"
          },
          "postal_code": {
            "type": "string"
          },
          "restaurant_id": {
            "type": "string"
          }
        },
        "required": [
          "restaurant_id",
          "postal_code",
          "lines"
        ],
        "type": "object"
      },
      "FoodOrder": {
        "additionalProperties": false,
        "properties": {
          "accept_by": {
            "format": "date-time",
            "type": "string"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "delivery_fee": {
            "$ref": "#/components/schemas/Money"
          },
          "estimated_ready_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/CartLine"
            },
            "type": "array"
          },
          "payment": {
            "$ref": "#/components/schemas/FoodPayment"
          },
          "postal_code": {
            "type": "string"
          },
          "pricing_version": {
            "type": "string"
          },
          "rejection_reason": {
            "type": "string"
          },
          "restaurant_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/FoodOrderStatus"
          },
          "subtotal": {
            "$ref": "#/components/schemas/Money"
          },
          "tax": {
            "$ref": "#/components/schemas/Money"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/OrderEvent"
            },
            "type": "array"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer_id",
          "restaurant_id",
          "revision",
          "status",
          "lines",
          "total",
          "payment",
          "pricing_version",
          "accept_by",
          "timeline",
          "created_at",
          "updated_at",
          "allowed_actions",
          "delivery_fee",
          "postal_code",
          "subtotal",
          "tax"
        ],
        "type": "object"
      },
      "FoodOrderStatus": {
        "enum": [
          "PENDING_RESTAURANT",
          "ACCEPTED",
          "PREPARING",
          "READY",
          "RIDER_ASSIGNED",
          "PICKED_UP",
          "DELIVERED",
          "REJECTED",
          "TIMED_OUT",
          "CANCELLED"
        ],
        "type": "string"
      },
      "FoodPayment": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "refund_state": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "method",
          "status",
          "reference"
        ],
        "type": "object"
      },
      "MenuItem": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "base_price": {
            "$ref": "#/components/schemas/Money"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "image_asset_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "option_groups": {
            "items": {
              "$ref": "#/components/schemas/OptionGroup"
            },
            "type": "array"
          },
          "restaurant_id": {
            "type": "string"
          },
          "vegetarian": {
            "type": "boolean"
          }
        },
        "required": [
          "available",
          "base_price",
          "category",
          "description",
          "id",
          "name",
          "option_groups",
          "restaurant_id",
          "vegetarian"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "type": "object"
      },
      "Option": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price_delta": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "available",
          "id",
          "name",
          "price_delta"
        ],
        "type": "object"
      },
      "OptionGroup": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "maximum": {
            "type": "integer"
          },
          "minimum": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "maximum",
          "minimum",
          "name",
          "options"
        ],
        "type": "object"
      },
      "OrderEvent": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/FoodOrderStatus"
          }
        },
        "required": [
          "actor",
          "created_at",
          "status"
        ],
        "type": "object"
      },
      "PricedOption": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price_delta": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "id",
          "name",
          "price_delta"
        ],
        "type": "object"
      },
      "Restaurant": {
        "additionalProperties": false,
        "properties": {
          "accept_until_minute": {
            "type": "integer"
          },
          "cuisine": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "delivery_fee": {
            "$ref": "#/components/schemas/Money"
          },
          "id": {
            "type": "string"
          },
          "minimum_order": {
            "$ref": "#/components/schemas/Money"
          },
          "name": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          },
          "owner_id": {
            "type": "string"
          },
          "postal_codes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "preparation_minutes": {
            "type": "integer"
          },
          "rating": {
            "type": "number"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "accept_until_minute",
          "cuisine",
          "delivery_fee",
          "id",
          "minimum_order",
          "name",
          "open",
          "postal_codes",
          "preparation_minutes",
          "rating",
          "updated_at",
          "verified"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Food API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/food-carts": {
      "post": {
        "operationId": "priceFoodCart",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodCart"
                }
              }
            },
            "description": "Server-priced cart"
          }
        }
      }
    },
    "/v1/food-orders": {
      "get": {
        "operationId": "listFoodOrders",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/FoodOrder"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Orders"
          }
        }
      },
      "post": {
        "operationId": "createFoodOrder",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodOrder"
                }
              }
            },
            "description": "Order"
          }
        }
      }
    },
    "/v1/food-orders/{order_id}": {
      "get": {
        "operationId": "getFoodOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodOrder"
                }
              }
            },
            "description": "Order"
          }
        }
      }
    },
    "/v1/food-orders/{order_id}/dispatch-transition": {
      "post": {
        "operationId": "transitionFoodDispatch",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodOrder"
                }
              }
            },
            "description": "Transitioned"
          }
        }
      }
    },
    "/v1/food-orders/{order_id}/restaurant-transition": {
      "post": {
        "operationId": "transitionRestaurantOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodOrder"
                }
              }
            },
            "description": "Transitioned"
          }
        }
      }
    },
    "/v1/restaurants": {
      "get": {
        "operationId": "listRestaurants",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/Restaurant"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Restaurants"
          }
        }
      }
    },
    "/v1/restaurants/{restaurant_id}/menu": {
      "get": {
        "operationId": "getRestaurantMenu",
        "parameters": [
          {
            "$ref": "#/components/parameters/RestaurantID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/MenuItem"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Menu"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-planext4u-reviewers": [
    "architecture",
    "security",
    "payments",
    "mobile"
  ]
}
