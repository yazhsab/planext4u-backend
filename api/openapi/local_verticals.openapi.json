{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ListingID": {
        "in": "path",
        "name": "listing_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "Cursor": {
        "in": "query",
        "name": "cursor",
        "required": false,
        "schema": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "Limit": {
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        }
      },
      "Query": {
        "in": "query",
        "name": "q",
        "required": false,
        "schema": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "Locality": {
        "in": "query",
        "name": "locality",
        "required": false,
        "schema": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "Category": {
        "in": "query",
        "name": "category",
        "required": false,
        "schema": {
          "maxLength": 100,
          "type": "string"
        }
      },
      "PropertyType": {
        "in": "query",
        "name": "property_type",
        "required": false,
        "schema": {
          "enum": ["APARTMENT", "HOUSE", "VILLA", "LAND", "COMMERCIAL"],
          "type": "string"
        }
      },
      "Purpose": {
        "in": "query",
        "name": "purpose",
        "required": false,
        "schema": {
          "enum": ["SALE", "RENT"],
          "type": "string"
        }
      },
      "MinPrice": {
        "in": "query",
        "name": "min_price",
        "required": false,
        "schema": {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "MaxPrice": {
        "in": "query",
        "name": "max_price",
        "required": false,
        "schema": {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "schemas": {
      "ClassifiedContactDisclosure": {
        "additionalProperties": false,
        "properties": {
          "contact": {
            "minLength": 8,
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "listing_id": {
            "type": "string"
          }
        },
        "required": ["listing_id", "contact"],
        "type": "object"
      },
      "ClassifiedListingPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicClassifiedListing"
            },
            "maxItems": 50,
            "type": "array"
          },
          "next_cursor": {
            "maxLength": 512,
            "type": "string"
          }
        },
        "required": ["items"],
        "type": "object"
      },
      "CreateClassifiedListingRequest": {
        "additionalProperties": false,
        "properties": {
          "category": {"minLength": 2, "maxLength": 100, "type": "string"},
          "contact": {"minLength": 8, "maxLength": 64, "type": "string", "x-planext4u-sensitive": true},
          "description": {"minLength": 8, "maxLength": 5000, "type": "string"},
          "locality": {"minLength": 2, "maxLength": 200, "type": "string"},
          "media_asset_ids": {
            "items": {"maxLength": 128, "type": "string", "x-planext4u-sensitive": true},
            "maxItems": 10,
            "type": "array"
          },
          "price": {"$ref": "#/components/schemas/Money"},
          "title": {"minLength": 4, "maxLength": 240, "type": "string"},
          "whatsapp_enabled": {"type": "boolean"}
        },
        "required": ["category", "title", "description", "price", "locality", "media_asset_ids", "contact", "whatsapp_enabled"],
        "type": "object"
      },
      "CreateHomeInquiryRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {"minLength": 3, "maxLength": 1000, "type": "string"}
        },
        "required": ["message"],
        "type": "object"
      },
      "CreateHomeListingRequest": {
        "additionalProperties": false,
        "properties": {
          "amenities": {"items": {"maxLength": 100, "type": "string"}, "maxItems": 50, "type": "array"},
          "area_sq_ft": {"maximum": 1000000, "minimum": 100, "type": "integer"},
          "bedrooms": {"maximum": 50, "minimum": 0, "type": "integer"},
          "latitude": {"maximum": 90, "minimum": -90, "type": "number", "x-planext4u-sensitive": true},
          "locality": {"minLength": 2, "maxLength": 200, "type": "string"},
          "longitude": {"maximum": 180, "minimum": -180, "type": "number", "x-planext4u-sensitive": true},
          "media_asset_ids": {
            "items": {"maxLength": 128, "type": "string", "x-planext4u-sensitive": true},
            "maxItems": 20,
            "type": "array"
          },
          "price": {"$ref": "#/components/schemas/Money"},
          "property_type": {"enum": ["APARTMENT", "HOUSE", "VILLA", "LAND", "COMMERCIAL"], "type": "string"},
          "purpose": {"enum": ["SALE", "RENT"], "type": "string"},
          "title": {"minLength": 4, "maxLength": 240, "type": "string"}
        },
        "required": ["title", "property_type", "purpose", "locality", "latitude", "longitude", "area_sq_ft", "bedrooms", "price", "amenities", "media_asset_ids"],
        "type": "object"
      },
      "HomeListingPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {"$ref": "#/components/schemas/PublicHomeListing"},
            "maxItems": 50,
            "type": "array"
          },
          "next_cursor": {"maxLength": 512, "type": "string"}
        },
        "required": ["items"],
        "type": "object"
      },
      "MediaPresentation": {
        "additionalProperties": false,
        "properties": {
          "alt_text": {"minLength": 1, "maxLength": 240, "type": "string"},
          "content_type": {"enum": ["image/jpeg", "image/png", "image/webp"], "type": "string"},
          "expires_at": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}]},
          "height": {"maximum": 16384, "minimum": 1, "type": "integer"},
          "url": {"type": "string", "x-planext4u-url-policy": "HTTPS or same-origin path"},
          "width": {"maximum": 16384, "minimum": 1, "type": "integer"}
        },
        "required": ["url", "content_type", "width", "height", "alt_text", "expires_at"],
        "type": "object"
      },
      "PublicClassifiedListing": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {"items": {"type": "string"}, "type": "array"},
          "category": {"type": "string"},
          "contact_masked": {"type": "string"},
          "created_at": {"format": "date-time", "type": "string"},
          "description": {"type": "string"},
          "expires_at": {"format": "date-time", "type": "string"},
          "featured_until": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}]},
          "id": {"type": "string"},
          "locality": {"type": "string"},
          "media": {"items": {"$ref": "#/components/schemas/MediaPresentation"}, "maxItems": 10, "type": "array"},
          "plan": {"enum": ["STANDARD", "FEATURED"], "type": "string"},
          "price": {"$ref": "#/components/schemas/Money"},
          "revision": {"minimum": 1, "type": "integer"},
          "title": {"type": "string"},
          "updated_at": {"format": "date-time", "type": "string"},
          "whatsapp_enabled": {"type": "boolean"}
        },
        "required": ["id", "revision", "category", "title", "description", "price", "locality", "media", "plan", "contact_masked", "whatsapp_enabled", "expires_at", "allowed_actions", "created_at", "updated_at"],
        "type": "object"
      },
      "PublicHomeListing": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {"items": {"type": "string"}, "type": "array"},
          "amenities": {"items": {"type": "string"}, "type": "array"},
          "area_sq_ft": {"type": "integer"},
          "bedrooms": {"type": "integer"},
          "created_at": {"format": "date-time", "type": "string"},
          "estimate": {"$ref": "#/components/schemas/HomeEstimate"},
          "featured_until": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}]},
          "id": {"type": "string"},
          "kyc_verified": {"type": "boolean"},
          "locality": {"type": "string"},
          "media": {"items": {"$ref": "#/components/schemas/MediaPresentation"}, "maxItems": 20, "type": "array"},
          "plan": {"enum": ["STANDARD", "FEATURED", "PREMIUM"], "type": "string"},
          "price": {"$ref": "#/components/schemas/Money"},
          "property_type": {"type": "string"},
          "purpose": {"enum": ["SALE", "RENT"], "type": "string"},
          "revision": {"minimum": 1, "type": "integer"},
          "title": {"type": "string"},
          "updated_at": {"format": "date-time", "type": "string"}
        },
        "required": ["id", "revision", "title", "property_type", "purpose", "locality", "area_sq_ft", "bedrooms", "price", "amenities", "media", "kyc_verified", "plan", "estimate", "allowed_actions", "created_at", "updated_at"],
        "type": "object"
      },
      "ReportClassifiedListingRequest": {
        "additionalProperties": false,
        "properties": {
          "details": {"maxLength": 1000, "type": "string"},
          "reason": {"minLength": 3, "maxLength": 100, "type": "string"}
        },
        "required": ["reason", "details"],
        "type": "object"
      },
      "RevealClassifiedContactRequest": {
        "additionalProperties": false,
        "properties": {
          "channel": {"enum": ["PHONE", "WHATSAPP"], "type": "string"},
          "consent": {"const": true, "type": "boolean"}
        },
        "required": ["channel", "consent"],
        "type": "object"
      },
      "ScheduleHomeVisitRequest": {
        "additionalProperties": false,
        "properties": {
          "scheduled_at": {"format": "date-time", "type": "string"}
        },
        "required": ["scheduled_at"],
        "type": "object"
      },
      "UpdateListingPlanRequest": {
        "additionalProperties": false,
        "properties": {
          "plan": {"enum": ["STANDARD", "FEATURED", "PREMIUM"], "type": "string"}
        },
        "required": ["plan"],
        "type": "object"
      },
      "ClassifiedListing": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "category": {
            "type": "string"
          },
          "contact_masked": {
            "type": "string"
          },
          "contact_revealed": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "featured_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "media_asset_ids": {
            "items": {
              "type": "string",
              "x-planext4u-sensitive": true
            },
            "type": "array"
          },
          "owner_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "plan": {
            "enum": [
              "STANDARD",
              "FEATURED"
            ],
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "report_count": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "PUBLISHED",
              "PENDING_REVIEW",
              "EXPIRED",
              "REMOVED"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "whatsapp_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "revision",
          "owner_id",
          "category",
          "title",
          "description",
          "price",
          "locality",
          "media_asset_ids",
          "status",
          "plan",
          "contact_masked",
          "whatsapp_enabled",
          "expires_at",
          "report_count",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "HomeEstimate": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "factors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "price_per_area": {
            "$ref": "#/components/schemas/Money"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "amount",
          "price_per_area",
          "factors",
          "generated_at"
        ],
        "type": "object"
      },
      "HomeListing": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "amenities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "area_sq_ft": {
            "type": "integer"
          },
          "bedrooms": {
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "estimate": {
            "$ref": "#/components/schemas/HomeEstimate"
          },
          "featured_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "kyc_verified": {
            "type": "boolean"
          },
          "latitude": {
            "type": "number",
            "x-planext4u-sensitive": true
          },
          "locality": {
            "type": "string"
          },
          "longitude": {
            "type": "number",
            "x-planext4u-sensitive": true
          },
          "media_asset_ids": {
            "items": {
              "type": "string",
              "x-planext4u-sensitive": true
            },
            "type": "array"
          },
          "owner_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "plan": {
            "enum": [
              "STANDARD",
              "FEATURED",
              "PREMIUM"
            ],
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "property_type": {
            "type": "string"
          },
          "purpose": {
            "enum": [
              "SALE",
              "RENT"
            ],
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "DRAFT",
              "ACTIVE",
              "PAUSED",
              "CLOSED"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "owner_id",
          "title",
          "property_type",
          "purpose",
          "locality",
          "latitude",
          "longitude",
          "area_sq_ft",
          "bedrooms",
          "price",
          "amenities",
          "media_asset_ids",
          "status",
          "kyc_verified",
          "plan",
          "estimate",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "Inquiry": {
        "additionalProperties": false,
        "properties": {
          "buyer_id": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "listing_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "buyer_id",
          "created_at",
          "id",
          "listing_id",
          "message",
          "status"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "type": "object"
      },
      "Visit": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "listing_id": {
            "type": "string"
          },
          "scheduled_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "visitor_id": {
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "id",
          "listing_id",
          "scheduled_at",
          "status",
          "visitor_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Homes and Classifieds API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/classifieds/listings": {
      "get": {
        "operationId": "browseClassifieds",
        "parameters": [
          {"$ref": "#/components/parameters/Query"},
          {"$ref": "#/components/parameters/Category"},
          {"$ref": "#/components/parameters/Locality"},
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ClassifiedListingPage"}
              }
            },
            "description": "Country-scoped published listings"
          }
        },
        "x-planext4u-guest-readable": true
      },
      "post": {
        "operationId": "createClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/CreateClassifiedListingRequest"}}
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Created or pending-review listing"
          }
        }
      }
    },
    "/v1/classifieds/listings/{listing_id}": {
      "get": {
        "operationId": "getClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicClassifiedListing"
                }
              }
            },
            "description": "Masked-contact listing"
          }
        },
        "x-planext4u-guest-readable": true
      }
    },
    "/v1/classifieds/listings/{listing_id}/contact": {
      "post": {
        "operationId": "revealClassifiedContact",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/RevealClassifiedContactRequest"}}
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedContactDisclosure"
                }
              }
            },
            "description": "Consented contact disclosure"
          }
        },
        "x-planext4u-explicit-consent-required": true
      }
    },
    "/v1/classifieds/listings/{listing_id}/reports": {
      "post": {
        "operationId": "reportClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/ReportClassifiedListingRequest"}}
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicClassifiedListing"
                }
              }
            },
            "description": "Moderation report accepted"
          }
        }
      }
    },
    "/v1/classifieds/listings/{listing_id}/repost": {
      "post": {
        "operationId": "repostClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Reposted expired listing"
          }
        },
        "x-planext4u-bodyless-command": true
      }
    },
    "/v1/classifieds/listings/{listing_id}/upgrade": {
      "post": {
        "operationId": "upgradeClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/UpdateListingPlanRequest"}}
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Updated listing plan"
          }
        }
      }
    },
    "/v1/classifieds/retention/expire": {
      "post": {
        "operationId": "expireClassifiedListings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
