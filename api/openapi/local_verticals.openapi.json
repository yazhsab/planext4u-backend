{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ListingID": {
        "in": "path",
        "name": "listing_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "schemas": {
      "ClassifiedListing": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "category": {
            "type": "string"
          },
          "contact_masked": {
            "type": "string"
          },
          "contact_revealed": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "featured_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "media_asset_ids": {
            "items": {
              "type": "string",
              "x-planext4u-sensitive": true
            },
            "type": "array"
          },
          "owner_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "plan": {
            "enum": [
              "STANDARD",
              "FEATURED"
            ],
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "report_count": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "PUBLISHED",
              "PENDING_REVIEW",
              "EXPIRED",
              "REMOVED"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "whatsapp_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "revision",
          "owner_id",
          "category",
          "title",
          "description",
          "price",
          "locality",
          "media_asset_ids",
          "status",
          "plan",
          "contact_masked",
          "whatsapp_enabled",
          "expires_at",
          "report_count",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "HomeEstimate": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "factors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "price_per_area": {
            "$ref": "#/components/schemas/Money"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "amount",
          "price_per_area",
          "factors",
          "generated_at"
        ],
        "type": "object"
      },
      "HomeListing": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "amenities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "area_sq_ft": {
            "type": "integer"
          },
          "bedrooms": {
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "estimate": {
            "$ref": "#/components/schemas/HomeEstimate"
          },
          "featured_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "kyc_verified": {
            "type": "boolean"
          },
          "latitude": {
            "type": "number",
            "x-planext4u-sensitive": true
          },
          "locality": {
            "type": "string"
          },
          "longitude": {
            "type": "number",
            "x-planext4u-sensitive": true
          },
          "media_asset_ids": {
            "items": {
              "type": "string",
              "x-planext4u-sensitive": true
            },
            "type": "array"
          },
          "owner_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "plan": {
            "enum": [
              "STANDARD",
              "FEATURED",
              "PREMIUM"
            ],
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "property_type": {
            "type": "string"
          },
          "purpose": {
            "enum": [
              "SALE",
              "RENT"
            ],
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "DRAFT",
              "ACTIVE",
              "PAUSED",
              "CLOSED"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "owner_id",
          "title",
          "property_type",
          "purpose",
          "locality",
          "latitude",
          "longitude",
          "area_sq_ft",
          "bedrooms",
          "price",
          "amenities",
          "media_asset_ids",
          "status",
          "kyc_verified",
          "plan",
          "estimate",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "Inquiry": {
        "additionalProperties": false,
        "properties": {
          "buyer_id": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "listing_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "buyer_id",
          "created_at",
          "id",
          "listing_id",
          "message",
          "status"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "type": "object"
      },
      "Visit": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "listing_id": {
            "type": "string"
          },
          "scheduled_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "visitor_id": {
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "id",
          "listing_id",
          "scheduled_at",
          "status",
          "visitor_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Homes and Classifieds API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/classifieds/listings": {
      "get": {
        "operationId": "browseClassifieds",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/ClassifiedListing"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Country-scoped published listings"
          }
        }
      },
      "post": {
        "operationId": "createClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Created or pending-review listing"
          }
        }
      }
    },
    "/v1/classifieds/listings/{listing_id}": {
      "get": {
        "operationId": "getClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Masked-contact listing"
          }
        }
      }
    },
    "/v1/classifieds/listings/{listing_id}/contact": {
      "post": {
        "operationId": "revealClassifiedContact",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Consented contact disclosure"
          }
        },
        "x-planext4u-explicit-consent-required": true
      }
    },
    "/v1/classifieds/listings/{listing_id}/reports": {
      "post": {
        "operationId": "reportClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Moderation report accepted"
          }
        }
      }
    },
    "/v1/classifieds/listings/{listing_id}/repost": {
      "post": {
        "operationId": "repostClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Reposted expired listing"
          }
        }
      }
    },
    "/v1/classifieds/listings/{listing_id}/upgrade": {
      "post": {
        "operationId": "upgradeClassifiedListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifiedListing"
                }
              }
            },
            "description": "Updated listing plan"
          }
        }
      }
    },
    "/v1/classifieds/retention/expire": {
      "post": {
        "operationId": "expireClassifiedListings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "expired": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "expired"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Expired eligible listings"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/homes/listings": {
      "get": {
        "operationId": "searchHomes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/HomeListing"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Country-scoped active home listings"
          }
        }
      },
      "post": {
        "operationId": "createHomeListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeListing"
                }
              }
            },
            "description": "KYC-associated draft listing"
          }
        }
      }
    },
    "/v1/homes/listings/{listing_id}": {
      "get": {
        "operationId": "getHomeListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeListing"
                }
              }
            },
            "description": "Authorized home listing"
          }
        }
      }
    },
    "/v1/homes/listings/{listing_id}/estimate": {
      "get": {
        "operationId": "getHomeEstimate",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeEstimate"
                }
              }
            },
            "description": "Versioned indicative valuation"
          }
        }
      }
    },
    "/v1/homes/listings/{listing_id}/inquiries": {
      "post": {
        "operationId": "createHomeInquiry",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inquiry"
                }
              }
            },
            "description": "Created inquiry"
          }
        }
      }
    },
    "/v1/homes/listings/{listing_id}/publish": {
      "post": {
        "operationId": "publishHomeListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeListing"
                }
              }
            },
            "description": "Published listing"
          }
        },
        "x-planext4u-kyc-required": true
      }
    },
    "/v1/homes/listings/{listing_id}/upgrade": {
      "post": {
        "operationId": "upgradeHomeListing",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeListing"
                }
              }
            },
            "description": "Updated listing plan"
          }
        }
      }
    },
    "/v1/homes/listings/{listing_id}/visits": {
      "post": {
        "operationId": "scheduleHomeVisit",
        "parameters": [
          {
            "$ref": "#/components/parameters/ListingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Visit"
                }
              }
            },
            "description": "Requested visit"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-planext4u-reviewers": [
    "architecture",
    "security",
    "privacy",
    "mobile"
  ]
}
