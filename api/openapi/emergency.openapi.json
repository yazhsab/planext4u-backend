{
  "openapi":"3.1.0","info":{"title":"Planext4u Emergency API","version":"1.0.0"},"x-planext4u-reviewers":["architecture","security","privacy","safety","mobile"],"security":[{"bearerAuth":[]}],
  "paths":{
    "/v1/emergency/requests":{"get":{"operationId":"listEmergencyRequests","responses":{"200":{"description":"Role-scoped requests"}}},"post":{"operationId":"createEmergencyRequest","x-planext4u-explicit-consent-required":true,"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"201":{"description":"Created request"}}}},
    "/v1/emergency/requests/{request_id}":{"get":{"operationId":"getEmergencyRequest","parameters":[{"$ref":"#/components/parameters/RequestID"}],"responses":{"200":{"description":"Authorized request with fresh location only"}}}},
    "/v1/emergency/requests/{request_id}/accept":{"post":{"operationId":"acceptEmergencyRequest","x-planext4u-mfa-required":true,"parameters":[{"$ref":"#/components/parameters/RequestID"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Atomic responder assignment"},"409":{"description":"Already assigned"}}}},
    "/v1/emergency/requests/{request_id}/location":{"put":{"operationId":"updateEmergencyLocation","x-planext4u-explicit-consent-required":true,"parameters":[{"$ref":"#/components/parameters/RequestID"}],"responses":{"200":{"description":"Updated or revoked location"}}}},
    "/v1/emergency/requests/{request_id}/communications":{"get":{"operationId":"listEmergencyCommunications","parameters":[{"$ref":"#/components/parameters/RequestID"}],"responses":{"200":{"description":"Requester/responder communications"}}},"post":{"operationId":"sendEmergencyCommunication","parameters":[{"$ref":"#/components/parameters/RequestID"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"201":{"description":"Encrypted communication delivered"}}}},
    "/v1/emergency/requests/{request_id}/transition":{"post":{"operationId":"transitionEmergencyRequest","x-planext4u-mfa-required":true,"parameters":[{"$ref":"#/components/parameters/RequestID"},{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"Revisioned response transition"}}}},
    "/v1/emergency/escalations/run":{"post":{"operationId":"runEmergencyEscalations","x-planext4u-mfa-required":true,"responses":{"200":{"description":"Escalated breached assignments"}}}},
    "/v1/emergency/reports/sla":{"get":{"operationId":"getEmergencySLAReport","x-planext4u-mfa-required":true,"responses":{"200":{"description":"Aggregate-only SLA report"}}}}
  },
  "components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},"parameters":{"RequestID":{"name":"request_id","in":"path","required":true,"schema":{"type":"string","maxLength":128}},"IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":128}},"IfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string"}}},"schemas":{
    "EmergencyLocation":{"type":"object","required":["latitude","longitude","accuracy_m","captured_at"],"properties":{"latitude":{"type":"number","x-planext4u-sensitive":true},"longitude":{"type":"number","x-planext4u-sensitive":true},"accuracy_m":{"type":"number"},"captured_at":{"type":"string","format":"date-time"}}},
    "EmergencyStatus":{"type":"string","enum":["OPEN","ASSIGNED","EN_ROUTE","ON_SCENE","RESOLVED"]},
    "EmergencyRequest":{"type":"object","required":["id","revision","requester_id","category","description","priority","status","location_consent","escalation_level","sla_deadline","allowed_actions","created_at","updated_at"],"properties":{"id":{"type":"string"},"revision":{"type":"integer"},"requester_id":{"type":"string","x-planext4u-sensitive":true},"category":{"type":"string"},"description":{"type":"string","x-planext4u-sensitive":true},"priority":{"type":"string","enum":["HIGH","CRITICAL"]},"status":{"$ref":"#/components/schemas/EmergencyStatus"},"assigned_responder":{"type":"string","x-planext4u-sensitive":true},"location_consent":{"type":"boolean"},"current_location":{"$ref":"#/components/schemas/EmergencyLocation"},"escalation_level":{"type":"integer"},"sla_deadline":{"type":"string","format":"date-time"},"allowed_actions":{"type":"array","items":{"type":"string"}},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
    "EmergencyMessage":{"type":"object","required":["id","request_id","sender_id","body","status","created_at"],"properties":{"id":{"type":"string"},"request_id":{"type":"string"},"sender_id":{"type":"string","x-planext4u-sensitive":true},"body":{"type":"string","x-planext4u-sensitive":true,"maxLength":2000},"status":{"type":"string","enum":["DELIVERED"]},"created_at":{"type":"string","format":"date-time"}}},
    "EmergencySLAReport":{"type":"object","required":["generated_at","open","assigned","resolved","breached","average_accept_seconds","by_category","location_precision"],"properties":{"generated_at":{"type":"string","format":"date-time"},"open":{"type":"integer"},"assigned":{"type":"integer"},"resolved":{"type":"integer"},"breached":{"type":"integer"},"average_accept_seconds":{"type":"integer"},"by_category":{"type":"object","additionalProperties":{"type":"integer"}},"location_precision":{"type":"string","enum":["aggregate_only"]}}}
  }}
}
