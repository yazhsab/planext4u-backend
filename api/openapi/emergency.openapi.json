{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RequestID": {
        "in": "path",
        "name": "request_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "schemas": {
      "EmergencyLocation": {
        "additionalProperties": false,
        "properties": {
          "accuracy_m": {
            "type": "number"
          },
          "captured_at": {
            "format": "date-time",
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "x-planext4u-sensitive": true
          },
          "longitude": {
            "type": "number",
            "x-planext4u-sensitive": true
          }
        },
        "required": [
          "latitude",
          "longitude",
          "accuracy_m",
          "captured_at"
        ],
        "type": "object"
      },
      "EmergencyMessage": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 2000,
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "status": {
            "enum": [
              "DELIVERED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "request_id",
          "sender_id",
          "body",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "EmergencyRequest": {
        "additionalProperties": false,
        "properties": {
          "accepted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "assigned_responder": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "category": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "current_location": {
            "$ref": "#/components/schemas/EmergencyLocation",
            "anyOf": [
              {
                "$ref": "#/components/schemas/EmergencyLocation"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "escalation_level": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "location_consent": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "HIGH",
              "CRITICAL"
            ],
            "type": "string"
          },
          "requester_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "resolved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "type": "integer"
          },
          "sla_deadline": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EmergencyStatus",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "requester_id",
          "category",
          "description",
          "priority",
          "status",
          "location_consent",
          "escalation_level",
          "sla_deadline",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "EmergencySLAReport": {
        "additionalProperties": false,
        "properties": {
          "assigned": {
            "type": "integer"
          },
          "average_accept_seconds": {
            "type": "integer"
          },
          "breached": {
            "type": "integer"
          },
          "by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "location_precision": {
            "enum": [
              "aggregate_only"
            ],
            "type": "string"
          },
          "open": {
            "type": "integer"
          },
          "resolved": {
            "type": "integer"
          }
        },
        "required": [
          "generated_at",
          "open",
          "assigned",
          "resolved",
          "breached",
          "average_accept_seconds",
          "by_category",
          "location_precision"
        ],
        "type": "object"
      },
      "EmergencyStatus": {
        "enum": [
          "OPEN",
          "ASSIGNED",
          "EN_ROUTE",
          "ON_SCENE",
          "RESOLVED"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Emergency API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/emergency/escalations/run": {
      "post": {
        "operationId": "runEmergencyEscalations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "escalated": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "escalated"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Escalated breached assignments"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/emergency/reports/sla": {
      "get": {
        "operationId": "getEmergencySLAReport",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencySLAReport"
                }
              }
            },
            "description": "Aggregate-only SLA report"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/emergency/requests": {
      "get": {
        "operationId": "listEmergencyRequests",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/EmergencyRequest"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Role-scoped requests"
          }
        }
      },
      "post": {
        "operationId": "createEmergencyRequest",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyRequest"
                }
              }
            },
            "description": "Created request"
          }
        },
        "x-planext4u-explicit-consent-required": true
      }
    },
    "/v1/emergency/requests/{request_id}": {
      "get": {
        "operationId": "getEmergencyRequest",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyRequest"
                }
              }
            },
            "description": "Authorized request with fresh location only"
          }
        }
      }
    },
    "/v1/emergency/requests/{request_id}/accept": {
      "post": {
        "operationId": "acceptEmergencyRequest",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyRequest"
                }
              }
            },
            "description": "Atomic responder assignment"
          },
          "409": {
            "description": "Already assigned"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/emergency/requests/{request_id}/communications": {
      "get": {
        "operationId": "listEmergencyCommunications",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/EmergencyMessage"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Requester/responder communications"
          }
        }
      },
      "post": {
        "operationId": "sendEmergencyCommunication",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyMessage"
                }
              }
            },
            "description": "Encrypted communication delivered"
          }
        }
      }
    },
    "/v1/emergency/requests/{request_id}/location": {
      "put": {
        "operationId": "updateEmergencyLocation",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyRequest"
                }
              }
            },
            "description": "Updated or revoked location"
          }
        },
        "x-planext4u-explicit-consent-required": true
      }
    },
    "/v1/emergency/requests/{request_id}/transition": {
      "post": {
        "operationId": "transitionEmergencyRequest",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyRequest"
                }
              }
            },
            "description": "Revisioned response transition"
          }
        },
        "x-planext4u-mfa-required": true
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-planext4u-reviewers": [
    "architecture",
    "security",
    "privacy",
    "safety",
    "mobile"
  ]
}
