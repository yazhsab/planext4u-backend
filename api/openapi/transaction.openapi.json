{
  "openapi": "3.1.0",
  "info": {"title": "Planext4u Checkout, Payment, Order and Wallet API", "version": "1.0.0"},
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/addresses": {
      "get": {"operationId": "transactionListAddresses", "responses": {"200": {"description": "Customer addresses", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Address"}}}}}}}, "403": {"$ref": "#/components/responses/Problem"}}},
      "post": {"operationId": "transactionCreateAddress", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddressInput"}}}}, "responses": {"201": {"description": "Address created", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Address"}}}}, "409": {"$ref": "#/components/responses/Problem"}, "422": {"$ref": "#/components/responses/Problem"}}}
    },
    "/v1/addresses/{address_id}": {
      "patch": {"operationId": "transactionUpdateAddress", "parameters": [{"$ref": "#/components/parameters/AddressID"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddressInput"}}}}, "responses": {"200": {"description": "Address updated", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Address"}}}}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}},
      "delete": {"operationId": "transactionDeleteAddress", "parameters": [{"$ref": "#/components/parameters/AddressID"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"204": {"description": "Address deleted"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}
    },
    "/v1/delivery-slots": {"get": {"operationId": "transactionListDeliverySlots", "responses": {"200": {"description": "Available delivery slots"}, "403": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/checkout/quotes": {"post": {"operationId": "transactionCreateQuote", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QuoteRequest"}}}}, "responses": {"201": {"description": "Server-authoritative quote", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Quote"}}}}, "409": {"$ref": "#/components/responses/Problem"}, "422": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/checkout/orders": {"post": {"operationId": "transactionPlaceOrder", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlaceOrderRequest"}}}}, "responses": {"201": {"description": "Atomic placement result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlaceOrderResult"}}}}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/payments/{payment_id}": {"get": {"operationId": "transactionGetPayment", "parameters": [{"name": "payment_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Payment", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Payment"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/payments/{payment_id}/retry": {"post": {"operationId": "transactionRetryPayment", "parameters": [{"name": "payment_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "New provider checkout handoff", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Payment"}}}}, "409": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/payments/webhooks/{provider}": {"post": {"operationId": "transactionAcceptProviderWebhook", "security": [], "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["razorpay", "paystack"]}}, {"name": "X-Razorpay-Signature", "in": "header", "required": false, "schema": {"type": "string"}}, {"name": "X-Razorpay-Event-Id", "in": "header", "required": false, "schema": {"type": "string"}}, {"name": "X-Paystack-Signature", "in": "header", "required": false, "schema": {"type": "string"}}], "responses": {"200": {"description": "Provider-native signed event accepted"}, "401": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/orders": {"get": {"operationId": "transactionListOrders", "responses": {"200": {"description": "Customer order history"}}}},
    "/v1/orders/{order_id}": {"get": {"operationId": "transactionGetOrder", "parameters": [{"$ref": "#/components/parameters/OrderID"}], "responses": {"200": {"description": "Order", "headers": {"ETag": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Order"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/orders/{order_id}/cancel": {"post": {"operationId": "transactionRequestCancellation", "parameters": [{"$ref": "#/components/parameters/OrderID"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"200": {"description": "Cancellation requested"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/orders/{order_id}/confirm-delivery": {"post": {"operationId": "transactionConfirmDelivery", "parameters": [{"$ref": "#/components/parameters/OrderID"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"200": {"description": "Delivery confirmed"}}}},
    "/v1/orders/{order_id}/returns": {"post": {"operationId": "transactionRequestReturn", "parameters": [{"$ref": "#/components/parameters/OrderID"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"201": {"description": "Return requested"}}}},
    "/v1/orders/{order_id}/rating": {"post": {"operationId": "transactionRateOrder", "parameters": [{"$ref": "#/components/parameters/OrderID"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}], "responses": {"201": {"description": "Rating recorded"}}}},
    "/v1/wallet": {"get": {"operationId": "transactionGetWallet", "responses": {"200": {"description": "Reconciled wallet ledger", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WalletAccount"}}}}}}},
    "/v1/wallet/experience": {"get": {"operationId": "transactionGetWalletExperience", "responses": {"200": {"description": "Wallet ledger, referral programme, refill offers and active rewards", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WalletExperience"}}}}}}},
    "/v1/wallet/referrals": {"post": {"operationId": "transactionApplyReferral", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string"}}}}}}, "responses": {"201": {"description": "Referral held for first captured purchase", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReferralProfile"}}}}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/wallet/refills": {"post": {"operationId": "transactionCreateWalletRefill", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WalletRefillRequest"}}}}, "responses": {"201": {"description": "Provider refill payment created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WalletRefillResult"}}}}, "409": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string"}},
      "AddressID": {"name": "address_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "OrderID": {"name": "order_id", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "responses": {"Problem": {"description": "Safe standard error", "content": {"application/json": {"schema": {"$ref": "./common.openapi.json#/components/schemas/ErrorEnvelope"}}}}},
    "schemas": {
      "Money": {"type": "object", "additionalProperties": false, "required": ["amount_minor", "currency"], "properties": {"amount_minor": {"type": "integer", "format": "int64", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
      "AddressInput": {"type": "object", "additionalProperties": false, "required": ["label", "line1", "postal_code", "locality", "default"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 60}, "line1": {"type": "string", "minLength": 3, "maxLength": 240}, "line2": {"type": "string", "maxLength": 240}, "postal_code": {"type": "string", "minLength": 3, "maxLength": 12}, "locality": {"type": "string", "minLength": 2, "maxLength": 100}, "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "default": {"type": "boolean"}}},
      "Address": {"type": "object", "additionalProperties": false, "required": ["id", "label", "line1", "postal_code", "locality", "serviceable", "default", "revision"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "line1": {"type": "string"}, "line2": {"type": "string"}, "postal_code": {"type": "string"}, "locality": {"type": "string"}, "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "serviceable": {"type": "boolean"}, "default": {"type": "boolean"}, "revision": {"type": "integer", "format": "int64", "minimum": 1}}},
      "PaymentMethod": {"type": "string", "enum": ["RAZORPAY", "PAYSTACK", "COD", "WALLET"]},
      "PaymentStatus": {"type": "string", "enum": ["PROVIDER_ORDER_CREATED", "AUTHORISATION_PENDING", "AUTHORISED", "CAPTURED", "RECONCILED", "FAILED_RETRYABLE", "FAILED_FINAL", "SIGNATURE_INVALID", "REFUND_REQUESTED", "REFUND_SUBMITTED", "REFUNDED", "REFUND_FAILED", "CANCELLED"]},
      "OrderStatus": {"type": "string", "enum": ["PENDING_PAYMENT", "PLACED", "ACCEPTED", "PACKING", "READY_FOR_HANDOVER", "ASSIGNED", "PICKED_UP", "OUT_FOR_DELIVERY", "DELIVERED_PENDING_CONFIRMATION", "COMPLETED", "CANCEL_REQUESTED", "CANCELLED", "RETURN_REQUESTED", "RETURN_APPROVED", "RETURN_REJECTED", "RETURNED", "REFUNDED"]},
      "QuoteRequest": {"type": "object", "additionalProperties": false, "required": ["cart_revision", "address_id", "delivery_slot_id", "wallet_points"], "properties": {"cart_revision": {"type": "integer", "format": "int64", "minimum": 0}, "address_id": {"type": "string"}, "delivery_slot_id": {"type": "string"}, "promotion_code": {"type": "string"}, "wallet_points": {"type": "integer", "format": "int64", "minimum": 0}}},
      "Quote": {"type": "object", "required": ["id", "cart_revision", "items", "address", "delivery", "subtotal", "discount", "tax", "fees", "wallet_applied", "wallet_points_redeemed", "total", "pricing_policy_version", "payment_methods", "warnings", "allowed_actions", "expires_at", "created_at"], "properties": {"id": {"type": "string"}, "cart_revision": {"type": "integer"}, "items": {"type": "array", "items": {"type": "object"}}, "address": {"$ref": "#/components/schemas/Address"}, "delivery": {"type": "object"}, "subtotal": {"$ref": "#/components/schemas/Money"}, "discount": {"$ref": "#/components/schemas/Money"}, "tax": {"$ref": "#/components/schemas/Money"}, "fees": {"$ref": "#/components/schemas/Money"}, "wallet_applied": {"$ref": "#/components/schemas/Money"}, "wallet_points_redeemed": {"type": "integer"}, "total": {"$ref": "#/components/schemas/Money"}, "promotion_code": {"type": "string"}, "pricing_policy_version": {"type": "string"}, "payment_methods": {"type": "array", "items": {"$ref": "#/components/schemas/PaymentMethod"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "allowed_actions": {"type": "array", "items": {"type": "string"}}, "expires_at": {"type": "string", "format": "date-time"}, "created_at": {"type": "string", "format": "date-time"}}},
      "PlaceOrderRequest": {"type": "object", "additionalProperties": false, "required": ["quote_id", "payment_method"], "properties": {"quote_id": {"type": "string"}, "payment_method": {"$ref": "#/components/schemas/PaymentMethod"}}},
      "ClientHandoff": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "enum": ["RAZORPAY_CHECKOUT", "PAYSTACK_CHECKOUT"]}, "public_key": {"type": "string"}, "provider_order_id": {"type": "string"}, "access_code": {"type": "string"}, "authorization_url": {"type": "string", "format": "uri"}}},
      "Payment": {"type": "object", "required": ["id", "order_reference", "method", "status", "amount", "allowed_actions", "created_at", "updated_at"], "properties": {"id": {"type": "string"}, "order_reference": {"type": "string"}, "method": {"$ref": "#/components/schemas/PaymentMethod"}, "status": {"$ref": "#/components/schemas/PaymentStatus"}, "amount": {"$ref": "#/components/schemas/Money"}, "refund_amount": {"$ref": "#/components/schemas/Money"}, "provider_reference": {"type": "string"}, "provider_transaction_reference": {"type": "string"}, "provider_refund_reference": {"type": "string"}, "client_handoff": {"$ref": "#/components/schemas/ClientHandoff"}, "allowed_actions": {"type": "array", "items": {"type": "string"}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "Order": {"type": "object", "required": ["id", "revision", "status", "snapshot", "allowed_actions", "timeline", "created_at", "updated_at"], "properties": {"id": {"type": "string"}, "revision": {"type": "integer", "format": "int64"}, "status": {"$ref": "#/components/schemas/OrderStatus"}, "snapshot": {"type": "object"}, "allowed_actions": {"type": "array", "items": {"type": "string"}}, "timeline": {"type": "array", "items": {"type": "object"}}, "proof": {"type": "object"}, "return": {"type": "object"}, "rating": {"type": "object"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "WalletEntry": {"type": "object", "required": ["id", "type", "category", "source_reference", "delta_points", "balance_after", "created_at"], "properties": {"id": {"type": "string"}, "type": {"type": "string", "enum": ["CREDIT", "DEBIT", "EXPIRY", "REVERSAL"]}, "category": {"type": "string"}, "source_reference": {"type": "string"}, "delta_points": {"type": "integer", "format": "int64"}, "balance_after": {"type": "integer", "format": "int64"}, "created_at": {"type": "string", "format": "date-time"}}},
      "WalletAccount": {"type": "object", "required": ["balance", "entries"], "properties": {"balance": {"type": "integer", "format": "int64", "minimum": 0}, "entries": {"type": "array", "items": {"$ref": "#/components/schemas/WalletEntry"}}}},
      "ReferralProfile": {"type": "object", "additionalProperties": false, "required": ["code", "sender_points", "recipient_points", "rewarded"], "properties": {"code": {"type": "string"}, "share_url": {"type": "string", "format": "uri"}, "sender_points": {"type": "integer", "format": "int64", "minimum": 0}, "recipient_points": {"type": "integer", "format": "int64", "minimum": 0}, "pending_code": {"type": "string"}, "rewarded": {"type": "boolean"}}},
      "WalletRefillOffer": {"type": "object", "additionalProperties": false, "required": ["id", "country", "points", "bonus_points", "price", "payment_methods"], "properties": {"id": {"type": "string"}, "country": {"type": "string"}, "points": {"type": "integer", "format": "int64", "minimum": 1}, "bonus_points": {"type": "integer", "format": "int64", "minimum": 0}, "price": {"$ref": "#/components/schemas/Money"}, "payment_methods": {"type": "array", "items": {"$ref": "#/components/schemas/PaymentMethod"}}}},
      "RewardCampaign": {"type": "object", "additionalProperties": false, "required": ["id", "country", "title", "description", "points", "ends_at"], "properties": {"id": {"type": "string"}, "country": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "points": {"type": "integer", "format": "int64", "minimum": 1}, "ends_at": {"type": "string", "format": "date-time"}}},
      "WalletExperience": {"type": "object", "additionalProperties": false, "required": ["account", "referral", "refills", "campaigns"], "properties": {"account": {"$ref": "#/components/schemas/WalletAccount"}, "referral": {"$ref": "#/components/schemas/ReferralProfile"}, "refills": {"type": "array", "items": {"$ref": "#/components/schemas/WalletRefillOffer"}}, "campaigns": {"type": "array", "items": {"$ref": "#/components/schemas/RewardCampaign"}}}},
      "WalletRefillRequest": {"type": "object", "additionalProperties": false, "required": ["offer_id", "payment_method"], "properties": {"offer_id": {"type": "string"}, "payment_method": {"type": "string", "enum": ["RAZORPAY", "PAYSTACK"]}}},
      "WalletRefillResult": {"type": "object", "additionalProperties": false, "required": ["offer", "payment"], "properties": {"offer": {"$ref": "#/components/schemas/WalletRefillOffer"}, "payment": {"$ref": "#/components/schemas/Payment"}, "credit": {"$ref": "#/components/schemas/WalletEntry"}}},
      "PlaceOrderResult": {"type": "object", "required": ["quote", "reservation", "payment", "order"], "properties": {"quote": {"$ref": "#/components/schemas/Quote"}, "reservation": {"type": "object"}, "payment": {"$ref": "#/components/schemas/Payment"}, "order": {"$ref": "#/components/schemas/Order"}, "wallet_debit": {"$ref": "#/components/schemas/WalletEntry"}}}
    }
  }
}
