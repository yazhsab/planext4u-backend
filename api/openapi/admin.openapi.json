{
  "openapi": "3.1.0",
  "info": {
    "title": "Planext4u Administrator Shell API",
    "version": "1.0.0"
  },
  "security": [{"adminSession": []}],
  "paths": {
    "/internal/v1/admin-sessions": {
      "post": {
        "operationId": "adminExchangeVerifiedSession",
        "security": [],
        "parameters": [
          {"name": "X-P4U-Admin-Timestamp", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[0-9]{10,12}$"}},
          {"name": "X-P4U-Admin-Signature", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^v1=[a-f0-9]{64}$"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSessionAssertion"}}}},
        "responses": {
          "201": {"description": "Opaque browser session issued from a verified upstream identity assertion", "headers": {"Set-Cookie": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSessionExchangeResult"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "415": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/session": {
      "get": {
        "operationId": "adminGetSession",
        "responses": {
          "200": {
            "description": "Current authorized administrator context",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminSession"}}}
          },
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      },
      "delete": {
        "operationId": "adminEndSession",
        "parameters": [{"$ref": "#/components/parameters/CSRFToken"}],
        "responses": {
          "204": {"description": "Administrator session revoked and cookie cleared"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/session/country": {
      "put": {
        "operationId": "adminSetCountry",
        "parameters": [{"$ref": "#/components/parameters/CSRFToken"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CountrySelection"}}}
        },
        "responses": {
          "204": {"description": "Country context changed"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/audit/events": {
      "get": {
        "operationId": "adminListAuditEvents",
        "parameters": [
          {"name": "actor_id", "in": "query", "schema": {"type": "string", "maxLength": 128}},
          {"name": "action", "in": "query", "schema": {"type": "string", "maxLength": 128}},
          {"name": "target_id", "in": "query", "schema": {"type": "string", "maxLength": 128}},
          {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200}}
        ],
        "responses": {
          "200": {
            "description": "Audit events restricted to the session tenant and selected country",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuditPage"}}}
          },
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/operations": {
      "get": {
        "operationId": "adminListOperations",
        "responses": {
          "200": {
            "description": "Changes visible to the administrator in the selected country",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationPage"}}}
          },
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      },
      "post": {
        "operationId": "adminSubmitOperation",
        "parameters": [{"$ref": "#/components/parameters/CSRFToken"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationInput"}}}
        },
        "responses": {
          "201": {
            "description": "Executed standard-risk change or high-risk change awaiting four-eyes approval",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationChange"}}}
          },
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/operations/{change_id}/approve": {
      "post": {
        "operationId": "adminApproveOperation",
        "parameters": [
          {"$ref": "#/components/parameters/CSRFToken"},
          {"name": "change_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationDecision"}}}
        },
        "responses": {
          "200": {"description": "Change approved and executed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationChange"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/operations/{change_id}/reject": {
      "post": {
        "operationId": "adminRejectOperation",
        "parameters": [
          {"$ref": "#/components/parameters/CSRFToken"},
          {"name": "change_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationRejection"}}}
        },
        "responses": {
          "200": {"description": "Change rejected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationChange"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/cms/pages": {
      "get": {
        "operationId": "adminListCMSPageDrafts",
        "responses": {
          "200": {"description": "Country-scoped CMS page drafts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CMSPageDraftPage"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/cms/pages/{page_id}/draft": {
      "put": {
        "operationId": "adminSaveCMSPageDraft",
        "parameters": [
          {"$ref": "#/components/parameters/CSRFToken"},
          {"name": "page_id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CMSPageDraftInput"}}}},
        "responses": {
          "200": {"description": "Revision-safe CMS page draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CMSPageDraft"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/cms/workspace": {
      "get": {
        "operationId": "adminGetCMSWorkspaceDraft",
        "responses": {
          "200": {"description": "Country-scoped global mobile configuration draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CMSWorkspaceDraft"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/cms/workspace/draft": {
      "put": {
        "operationId": "adminSaveCMSWorkspaceDraft",
        "parameters": [{"$ref": "#/components/parameters/CSRFToken"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CMSWorkspaceDraftInput"}}}},
        "responses": {
          "200": {"description": "Revision-safe global mobile configuration draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CMSWorkspaceDraft"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/governance": {
      "get": {
        "operationId": "adminGetGovernance",
        "x-planext4u-mfa-required": true,
        "responses": {
          "200": {"description": "Country-scoped aggregate governance dashboard", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GovernanceView"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/admin/api/v1/operations/audit": {
      "get": {
        "operationId": "adminListOperationAudit",
        "responses": {
          "200": {"description": "Immutable privileged-operation audit evidence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminOperationAuditPage"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-p4u_admin",
        "description": "Opaque Secure, HttpOnly, SameSite=Strict host-only session cookie"
      }
    },
    "parameters": {
      "CSRFToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "minLength": 32, "maxLength": 256}
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe standard error",
        "content": {"application/json": {"schema": {"$ref": "./common.openapi.json#/components/schemas/ErrorEnvelope"}}}
      }
    },
    "schemas": {
      "AdminRole": {
        "type": "string",
        "enum": ["SUPER_ADMIN", "COUNTRY_ADMIN", "CONTENT_ADMIN", "SUPPORT_ADMIN", "AUDITOR"]
      },
      "AdminSessionAssertion": {
        "type": "object", "additionalProperties": false,
        "required": ["subject_id", "session_id", "tenant_id", "display_name", "roles", "allowed_countries", "selected_country", "authenticated_at", "auth_methods"],
        "properties": {
          "subject_id": {"type": "string", "format": "uuid"}, "session_id": {"type": "string", "format": "uuid"}, "tenant_id": {"type": "string", "format": "uuid"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 128}, "roles": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/components/schemas/AdminRole"}},
          "allowed_countries": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
          "selected_country": {"type": "string", "pattern": "^[A-Z]{2}$"}, "authenticated_at": {"type": "string", "format": "date-time"},
          "auth_methods": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}}
        }
      },
      "AdminSessionExchangeResult": {"type": "object", "additionalProperties": false, "required": ["expires_at"], "properties": {"expires_at": {"type": "string", "format": "date-time"}}},
      "AdminAssurance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mfa_satisfied", "fresh_auth", "auth_time"],
        "properties": {
          "mfa_satisfied": {"type": "boolean"},
          "fresh_auth": {"type": "boolean"},
          "auth_time": {"type": "string", "format": "date-time"}
        }
      },
      "NavigationItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path", "capability"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "path": {"type": "string"},
          "capability": {"type": "string"}
        }
      },
      "AdminSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "display_name", "roles", "capabilities", "allowed_countries", "selected_country", "assurance", "navigation", "csrf_token"],
        "properties": {
          "subject_id": {"type": "string"},
          "display_name": {"type": "string"},
          "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/AdminRole"}},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "allowed_countries": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
          "selected_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "assurance": {"$ref": "#/components/schemas/AdminAssurance"},
          "navigation": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/NavigationItem"}},
          "csrf_token": {"type": "string", "minLength": 32, "x-planext4u-sensitive": true}
        }
      },
      "CountrySelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country"],
        "properties": {"country": {"type": "string", "pattern": "^[A-Z]{2}$"}}
      },
      "AdminOperationDomain": {
        "type": "string",
        "enum": ["CATALOG", "ORDER", "PAYMENT", "WALLET", "CAMPAIGN", "CMS", "SUPPORT", "REPORTING", "SUPPLY", "RESTAURANT", "DISPATCH", "SETTLEMENT", "FRANCHISE", "CONTENT", "POLICY", "COUNTRY", "EMERGENCY", "INTELLIGENCE"]
      },
      "GovernanceMetric": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "value", "unit", "freshness", "masked"],
        "properties": {"id":{"type":"string"},"title":{"type":"string"},"value":{"type":"integer","format":"int64"},"unit":{"type":"string"},"freshness":{"type":"string","format":"date-time"},"masked":{"type":"boolean"}}
      },
      "GovernanceView": {
        "type": "object", "additionalProperties": false,
        "required": ["country", "policy_version", "feature_flags", "metrics", "privacy_mode", "generated_at"],
        "properties": {"country":{"type":"string","pattern":"^[A-Z]{2}$"},"policy_version":{"type":"string"},"feature_flags":{"type":"object","additionalProperties":{"type":"boolean"}},"metrics":{"type":"array","items":{"$ref":"#/components/schemas/GovernanceMetric"}},"privacy_mode":{"type":"string","enum":["aggregate_and_masked"]},"generated_at":{"type":"string","format":"date-time"}}
      },
      "AdminOperationRisk": {"type": "string", "enum": ["STANDARD", "HIGH"]},
      "AdminOperationStatus": {"type": "string", "enum": ["PENDING_APPROVAL", "EXECUTED", "REJECTED"]},
      "CMSPageDraftInput": {"type": "object", "additionalProperties": false, "required": ["expected_revision", "page"], "properties": {"expected_revision": {"type": "integer", "format": "int64", "minimum": 0}, "page": {"$ref": "./configuration.openapi.json#/components/schemas/Page"}}},
      "CMSPageDraft": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "country", "page", "revision", "updated_by", "updated_at"], "properties": {"tenant_id": {"type": "string"}, "country": {"type": "string", "pattern": "^[A-Z]{2}$"}, "page": {"$ref": "./configuration.openapi.json#/components/schemas/Page"}, "revision": {"type": "integer", "format": "int64", "minimum": 1}, "updated_by": {"type": "string"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "CMSPageDraftPage": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/CMSPageDraft"}}}},
      "CMSWorkspaceDraftInput": {"type": "object", "additionalProperties": false, "required": ["expected_revision", "workspace"], "properties": {"expected_revision": {"type": "integer", "format": "int64", "minimum": 0}, "workspace": {"$ref": "./configuration.openapi.json#/components/schemas/Workspace"}}},
      "CMSWorkspaceDraft": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "country", "workspace", "revision", "updated_by", "updated_at"], "properties": {"tenant_id": {"type": "string", "format": "uuid"}, "country": {"type": "string", "pattern": "^[A-Z]{2}$"}, "workspace": {"$ref": "./configuration.openapi.json#/components/schemas/Workspace"}, "revision": {"type": "integer", "format": "int64", "minimum": 1}, "updated_by": {"type": "string"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "AdminOperationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "action", "target_id", "reason", "payload"],
        "properties": {
          "domain": {"$ref": "#/components/schemas/AdminOperationDomain"},
          "action": {"type": "string", "minLength": 1, "maxLength": 128},
          "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason": {"type": "string", "minLength": 8, "maxLength": 500},
          "payload": {"type": "object", "maxProperties": 64, "additionalProperties": true}
        }
      },
      "AdminOperationCommand": {
        "allOf": [
          {"$ref": "#/components/schemas/AdminOperationInput"},
          {
            "type": "object",
            "required": ["correlation_id"],
            "properties": {"correlation_id": {"type": "string", "minLength": 1, "maxLength": 128}}
          }
        ]
      },
      "AdminOperationChange": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "tenant_id", "country", "command", "risk", "status", "requested_by", "created_at", "updated_at"],
        "properties": {
          "id": {"type": "string"},
          "revision": {"type": "integer", "format": "int64", "minimum": 1},
          "tenant_id": {"type": "string"},
          "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "command": {"$ref": "#/components/schemas/AdminOperationCommand"},
          "risk": {"$ref": "#/components/schemas/AdminOperationRisk"},
          "status": {"$ref": "#/components/schemas/AdminOperationStatus"},
          "requested_by": {"type": "string"},
          "approved_by": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "AdminOperationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changes"],
        "properties": {"changes": {"type": "array", "items": {"$ref": "#/components/schemas/AdminOperationChange"}}}
      },
      "AdminOperationDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision"],
        "properties": {"expected_revision": {"type": "integer", "format": "int64", "minimum": 1}}
      },
      "AdminOperationRejection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_revision", "reason"],
        "properties": {
          "expected_revision": {"type": "integer", "format": "int64", "minimum": 1},
          "reason": {"type": "string", "minLength": 8, "maxLength": 500}
        }
      },
      "AdminOperationAuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "tenant_id", "country", "actor_id", "action", "target_id", "outcome", "reason", "correlation_id", "created_at"],
        "properties": {
          "sequence": {"type": "integer", "format": "int64", "minimum": 1},
          "tenant_id": {"type": "string"},
          "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "actor_id": {"type": "string"},
          "action": {"type": "string"},
          "target_id": {"type": "string"},
          "outcome": {"type": "string", "enum": ["SUCCEEDED", "DENIED", "FAILED"]},
          "reason": {"type": "string"},
          "correlation_id": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "AdminOperationAuditPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["events"],
        "properties": {"events": {"type": "array", "items": {"$ref": "#/components/schemas/AdminOperationAuditEvent"}}}
      },
      "AuditOutcome": {"type": "string", "enum": ["SUCCEEDED", "DENIED", "FAILED"]},
      "AuditActor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "actor_type"],
        "properties": {
          "subject_id": {"type": "string"},
          "actor_type": {"type": "string", "enum": ["USER", "SERVICE", "SYSTEM"]},
          "ip_prefix": {"type": "string"}
        }
      },
      "AuditTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {"type": {"type": "string"}, "id": {"type": "string"}}
      },
      "AuditEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tenant_id", "country", "actor", "action", "target", "outcome", "reason_code", "correlation_id", "occurred_at", "recorded_at", "hash", "sequence"],
        "properties": {
          "id": {"type": "string"},
          "tenant_id": {"type": "string"},
          "country": {"type": "string"},
          "actor": {"$ref": "#/components/schemas/AuditActor"},
          "action": {"type": "string"},
          "target": {"$ref": "#/components/schemas/AuditTarget"},
          "outcome": {"$ref": "#/components/schemas/AuditOutcome"},
          "reason_code": {"type": "string"},
          "correlation_id": {"type": "string"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "recorded_at": {"type": "string", "format": "date-time"},
          "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sequence": {"type": "integer", "format": "int64", "minimum": 1}
        }
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries", "has_more"],
        "properties": {
          "entries": {"type": "array", "items": {"$ref": "#/components/schemas/AuditEntry"}},
          "next_cursor": {"type": "string"},
          "has_more": {"type": "boolean"}
        }
      }
    }
  },
  "x-planext4u-owner": "administrator-experience",
  "x-planext4u-reviewers": ["security", "privacy", "accessibility"],
  "x-planext4u-classification": "restricted",
  "x-planext4u-slo-class": "critical"
}
