{
  "components": {
    "parameters": {
      "BookingID": {
        "in": "path",
        "name": "booking_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "HoldID": {
        "in": "path",
        "name": "hold_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 16,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ServiceID": {
        "in": "path",
        "name": "service_id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "responses": {
      "Problem": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./common.openapi.json#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "description": "Safe standard error"
      }
    },
    "schemas": {
      "BookingStatus": {
        "enum": [
          "PENDING_PAYMENT",
          "REQUESTED",
          "ACCEPTED",
          "PROVIDER_EN_ROUTE",
          "ARRIVED",
          "START_OTP_REQUIRED",
          "IN_PROGRESS",
          "COMPLETION_EVIDENCE_REQUIRED",
          "COMPLETED_PENDING_CONFIRMATION",
          "COMPLETED",
          "RESCHEDULE_REQUESTED",
          "CANCEL_REQUESTED",
          "CANCELLED",
          "DECLINED",
          "CUSTOMER_NO_SHOW",
          "PROVIDER_NO_SHOW",
          "DISPUTED"
        ],
        "type": "string"
      },
      "ClientHandoff": {
        "additionalProperties": false,
        "properties": {
          "access_code": {
            "type": "string"
          },
          "authorization_url": {
            "type": "string"
          },
          "provider_order_id": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "CompletionEvidence": {
        "additionalProperties": false,
        "properties": {
          "captured_at": {
            "format": "date-time",
            "type": "string"
          },
          "photo_asset_id": {
            "type": "string"
          },
          "submitted_by": {
            "type": "string"
          }
        },
        "required": [
          "photo_asset_id",
          "captured_at",
          "submitted_by"
        ],
        "type": "object"
      },
      "CompletionRequest": {
        "additionalProperties": false,
        "properties": {
          "photo_asset_id": {
            "type": "string"
          }
        },
        "required": [
          "photo_asset_id"
        ],
        "type": "object"
      },
      "CreateBookingRequest": {
        "additionalProperties": false,
        "properties": {
          "hold_id": {
            "type": "string"
          },
          "payment_method": {
            "$ref": "#/components/schemas/PaymentMethod"
          }
        },
        "required": [
          "hold_id",
          "payment_method"
        ],
        "type": "object"
      },
      "HoldSlotRequest": {
        "additionalProperties": false,
        "properties": {
          "postal_code": {
            "maxLength": 12,
            "minLength": 3,
            "type": "string"
          },
          "slot_id": {
            "type": "string"
          }
        },
        "required": [
          "slot_id",
          "postal_code"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "type": "object"
      },
      "Payment": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "client_handoff": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClientHandoff"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/PaymentMethod",
            "type": "string"
          },
          "order_reference": {
            "type": "string"
          },
          "provider_reference": {
            "type": "string"
          },
          "provider_refund_reference": {
            "type": "string"
          },
          "provider_transaction_reference": {
            "type": "string"
          },
          "refund_amount": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "order_reference",
          "method",
          "status",
          "amount",
          "allowed_actions",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "PaymentMethod": {
        "enum": [
          "RAZORPAY",
          "PAYSTACK",
          "WALLET"
        ],
        "type": "string"
      },
      "PaymentMode": {
        "enum": [
          "FULL",
          "ADVANCE"
        ],
        "type": "string"
      },
      "PaymentStatus": {
        "type": "string"
      },
      "ProviderTransitionRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "type": "object"
      },
      "ReasonRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "RescheduleRequest": {
        "additionalProperties": false,
        "properties": {
          "hold_id": {
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "hold_id",
          "reason"
        ],
        "type": "object"
      },
      "ServiceBooking": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "amount_due": {
            "$ref": "#/components/schemas/Money"
          },
          "completion_evidence": {
            "$ref": "#/components/schemas/CompletionEvidence",
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompletionEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "free_reschedules_left": {
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "offering": {
            "$ref": "#/components/schemas/ServiceOffering"
          },
          "payment": {
            "$ref": "#/components/schemas/Payment"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "reschedule_count": {
            "minimum": 0,
            "type": "integer"
          },
          "revision": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "slot": {
            "$ref": "#/components/schemas/ServiceSlot"
          },
          "start_otp": {
            "pattern": "^[0-9]{6}$",
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineEvent"
            },
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "status",
          "offering",
          "slot",
          "price",
          "amount_due",
          "payment",
          "reschedule_count",
          "free_reschedules_left",
          "allowed_actions",
          "timeline",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ServiceOffering": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "advance": {
            "$ref": "#/components/schemas/Money"
          },
          "cancellation_policy_ref": {
            "type": "string"
          },
          "category_id": {
            "type": "string"
          },
          "completed_bookings": {
            "minimum": 0,
            "type": "integer"
          },
          "duration_minutes": {
            "minimum": 15,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "live_engagements": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "payment_mode": {
            "$ref": "#/components/schemas/PaymentMode"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "provider_id": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "rating_average": {
            "maximum": 5,
            "minimum": 0,
            "type": "number"
          },
          "reschedule_policy_ref": {
            "type": "string"
          },
          "service_postal_codes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "summary": {
            "type": "string"
          },
          "verified_provider": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "provider_id",
          "provider_name",
          "category_id",
          "name",
          "summary",
          "duration_minutes",
          "price",
          "advance",
          "payment_mode",
          "verified_provider",
          "rating_average",
          "completed_bookings",
          "live_engagements",
          "service_postal_codes",
          "cancellation_policy_ref",
          "reschedule_policy_ref",
          "active"
        ],
        "type": "object"
      },
      "ServiceSlot": {
        "additionalProperties": false,
        "properties": {
          "advance": {
            "$ref": "#/components/schemas/Money"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "buffer_minutes": {
            "minimum": 0,
            "type": "integer"
          },
          "capacity": {
            "minimum": 1,
            "type": "integer"
          },
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "offering_id": {
            "type": "string"
          },
          "policy_version": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "provider_id": {
            "type": "string"
          },
          "provider_version": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "remaining": {
            "minimum": 0,
            "type": "integer"
          },
          "service_date": {
            "format": "date",
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "time_zone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "offering_id",
          "provider_id",
          "starts_at",
          "ends_at",
          "time_zone",
          "capacity",
          "remaining",
          "buffer_minutes",
          "price",
          "advance",
          "allowed_actions",
          "policy_version",
          "service_date",
          "provider_version"
        ],
        "type": "object"
      },
      "SlotHold": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "offering_id": {
            "type": "string"
          },
          "slot_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SlotHoldStatus"
          }
        },
        "required": [
          "id",
          "slot_id",
          "offering_id",
          "status",
          "expires_at",
          "created_at",
          "allowed_actions"
        ],
        "type": "object"
      },
      "SlotHoldStatus": {
        "enum": [
          "HELD",
          "CONSUMED",
          "EXPIRED",
          "RELEASED"
        ],
        "type": "string"
      },
      "StartRequest": {
        "additionalProperties": false,
        "properties": {
          "otp": {
            "pattern": "^[0-9]{6}$",
            "type": "string",
            "x-planext4u-sensitive": true
          }
        },
        "required": [
          "otp"
        ],
        "type": "object"
      },
      "TimelineEvent": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          }
        },
        "required": [
          "status",
          "actor",
          "created_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Service Booking API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/service-bookings": {
      "get": {
        "operationId": "bookingListBookings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/ServiceBooking"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Actor-scoped booking queue"
          }
        }
      },
      "post": {
        "operationId": "bookingCreateBooking",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Booking and authoritative payment",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}": {
      "get": {
        "operationId": "bookingGetBooking",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Actor-scoped booking",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/cancel": {
      "post": {
        "operationId": "bookingCancel",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Cancelled booking with financial compensation state"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/completion": {
      "post": {
        "operationId": "bookingSubmitCompletion",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Completion evidence submitted"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/confirm-completion": {
      "post": {
        "operationId": "bookingConfirmCompletion",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Customer completion confirmation"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/disputes": {
      "post": {
        "operationId": "bookingOpenDispute",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Booking dispute opened"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/no-show": {
      "post": {
        "operationId": "bookingReportNoShow",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Actor-scoped no-show recorded"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/payment-confirmation": {
      "post": {
        "operationId": "bookingConfirmPayment",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Provider payment verified against server state"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/service-bookings/{booking_id}/provider-status": {
      "post": {
        "operationId": "bookingProviderTransition",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookingID"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTransitionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceBooking"
                }
              }
            },
            "description": "Provider-owned lifecycle transition"
