{
  "openapi": "3.1.0",
  "info": {"title": "Planext4u Catalog Read and Customer Home API", "version": "1.2.0"},
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/home": {"get": {"operationId": "catalogGetCustomerHome", "parameters": [{"name": "postal_code", "in": "query", "schema": {"type": "string", "minLength": 3, "maxLength": 12}, "description": "Customer service location used for server-owned serviceability"}], "responses": {"200": {"description": "Customer home projection with CMS-keyed service collections", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Home"}}}}, "422": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/catalog/categories": {"get": {"operationId": "catalogListCategories", "responses": {"200": {"description": "Categories", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CategoryPage"}}}}}}},
    "/v1/catalog/items": {"get": {"operationId": "catalogListItems", "parameters": [{"name": "category_id", "in": "query", "schema": {"type": "string"}}, {"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Catalog items", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemPage"}}}}, "422": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/catalog/items/{item_id}": {"get": {"operationId": "catalogGetItem", "parameters": [{"name": "item_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Catalog item", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/catalog/items/{item_id}/questions": {"post": {"operationId": "catalogAskQuestion", "parameters": [{"name": "item_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AskQuestionInput"}}}}, "responses": {"201": {"description": "Customer question accepted for seller response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Question"}}}}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "422": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/catalog/search": {"get": {"operationId": "catalogSearch", "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 100}}, {"name": "category_id", "in": "query", "schema": {"type": "string", "maxLength": 128}}, {"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Search results filtered by the server-authoritative category when supplied", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemPage"}}}}, "422": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/catalog/suggestions": {"get": {"operationId": "catalogSuggestions", "parameters": [{"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 100}}], "responses": {"200": {"description": "Trending, product, vendor and tag suggestions", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 12, "items": {"$ref": "#/components/schemas/Suggestion"}}}}}}}, "422": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/serviceability/check": {"post": {"operationId": "catalogCheckServiceability", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GeoPoint"}}}}, "responses": {"200": {"description": "Serviceability decision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Serviceability"}}}}, "422": {"$ref": "#/components/responses/Problem"}}}},
    "/v1/geocoding/search": {"get": {"operationId": "catalogSearchGeocoding", "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "minLength": 2, "maxLength": 100}}], "responses": {"200": {"description": "Service-area locality and pincode candidates", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 10, "items": {"$ref": "#/components/schemas/GeocodeCandidate"}}}}}}}, "422": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {"Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 512}}, "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}}},
    "responses": {"Problem": {"description": "Safe standard error", "content": {"application/json": {"schema": {"$ref": "./common.openapi.json#/components/schemas/ErrorEnvelope"}}}}},
    "schemas": {
      "ProjectionStatus": {"type": "string", "enum": ["FRESH", "STALE", "DEGRADED"]},
      "Money": {"type": "object", "additionalProperties": false, "required": ["amount_minor", "currency"], "properties": {"amount_minor": {"type": "integer", "format": "int64", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
      "Variant": {"type": "object", "additionalProperties": false, "required": ["id", "label", "price", "available", "stock_quantity", "max_per_order"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "price": {"$ref": "#/components/schemas/Money"}, "compare_at_price": {"$ref": "#/components/schemas/Money"}, "available": {"type": "boolean"}, "stock_quantity": {"type": "integer", "minimum": 0}, "max_per_order": {"type": "integer", "minimum": 1, "maximum": 999}}},
      "ResponsiveMediaVariant": {"type": "object", "additionalProperties": false, "required": ["url", "width", "height"], "properties": {"url": {"type": "string", "x-planext4u-url-policy": "HTTPS or same-origin path"}, "width": {"type": "integer", "minimum": 1, "maximum": 16384}, "height": {"type": "integer", "minimum": 1, "maximum": 16384}}},
      "MediaPresentation": {"type": "object", "additionalProperties": false, "required": ["asset_id", "url", "content_type", "width", "height", "alt_text", "variants", "expires_at"], "properties": {"asset_id": {"type": "string"}, "url": {"type": "string", "x-planext4u-url-policy": "HTTPS or same-origin path"}, "content_type": {"type": "string", "enum": ["image/jpeg", "image/png", "image/webp"]}, "width": {"type": "integer", "minimum": 1, "maximum": 16384}, "height": {"type": "integer", "minimum": 1, "maximum": 16384}, "alt_text": {"type": "string", "minLength": 1, "maxLength": 240}, "variants": {"type": "array", "maxItems": 10, "items": {"$ref": "#/components/schemas/ResponsiveMediaVariant"}}, "expires_at": {"type": ["string", "null"], "format": "date-time"}}},
      "Category": {"type": "object", "additionalProperties": false, "required": ["id", "name", "priority"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "icon_ref": {"type": "string"}, "icon": {"$ref": "#/components/schemas/MediaPresentation"}, "priority": {"type": "integer"}}},
      "Review": {"type": "object", "additionalProperties": false, "required": ["id", "author_display_name", "score", "body", "verified_purchase", "created_at"], "properties": {"id": {"type": "string"}, "author_display_name": {"type": "string"}, "score": {"type": "integer", "minimum": 1, "maximum": 5}, "body": {"type": "string", "maxLength": 4000}, "verified_purchase": {"type": "boolean"}, "created_at": {"type": "string", "format": "date-time"}}},
      "AskQuestionInput": {"type": "object", "additionalProperties": false, "required": ["question"], "properties": {"question": {"type": "string", "minLength": 5, "maxLength": 500}}},
      "Question": {"type": "object", "additionalProperties": false, "required": ["id", "question", "asked_by", "asked_at"], "properties": {"id": {"type": "string"}, "question": {"type": "string", "maxLength": 500}, "asked_by": {"type": "string"}, "asked_at": {"type": "string", "format": "date-time"}, "answer": {"type": "string", "maxLength": 4000}, "answered_by": {"type": "string"}, "answered_at": {"type": "string", "format": "date-time"}}},
      "Item": {"type": "object", "additionalProperties": false, "required": ["id", "category_id", "name", "summary", "price", "available"], "properties": {"id": {"type": "string"}, "category_id": {"type": "string"}, "name": {"type": "string"}, "summary": {"type": "string"}, "media_ref": {"type": "string"}, "media_refs": {"type": "array", "maxItems": 20, "items": {"type": "string", "format": "uri"}}, "media": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/MediaPresentation"}}, "price": {"$ref": "#/components/schemas/Money"}, "available": {"type": "boolean"}, "seller_name": {"type": "string"}, "verified_local_seller": {"type": "boolean"}, "description": {"type": "string"}, "specifications": {"type": "object", "additionalProperties": {"type": "string"}}, "rating_average": {"type": "number", "minimum": 0, "maximum": 5}, "review_count": {"type": "integer", "minimum": 0}, "variants": {"type": "array", "items": {"$ref": "#/components/schemas/Variant"}}, "delivery_estimate": {"type": "string", "maxLength": 240}, "reviews": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Review"}}, "questions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Question"}}, "related_item_ids": {"type": "array", "maxItems": 50, "items": {"type": "string"}}}},
      "CategoryPage": {"type": "object", "additionalProperties": false, "required": ["items", "has_more", "projection_status", "generated_at"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Category"}}, "has_more": {"type": "boolean"}, "projection_status": {"$ref": "#/components/schemas/ProjectionStatus"}, "generated_at": {"type": "string", "format": "date-time"}}},
      "ItemPage": {"type": "object", "additionalProperties": false, "required": ["items", "has_more", "projection_status", "generated_at"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Item"}}, "next_cursor": {"type": "string"}, "has_more": {"type": "boolean"}, "projection_status": {"$ref": "#/components/schemas/ProjectionStatus"}, "generated_at": {"type": "string", "format": "date-time"}}},
      "SellerLeader": {"type": "object", "additionalProperties": false, "required": ["seller_name", "verified", "rating_average", "review_count"], "properties": {"seller_name": {"type": "string"}, "verified": {"type": "boolean"}, "rating_average": {"type": "number", "minimum": 0, "maximum": 5}, "review_count": {"type": "integer", "minimum": 0}}},
      "HelpShortcut": {"type": "object", "additionalProperties": false, "required": ["id", "title", "route"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "route": {"type": "string", "pattern": "^/app/"}}},
      "ServiceTrustSummary": {"type": "object", "additionalProperties": false, "required": ["verified_provider", "rating_average", "completed_bookings"], "properties": {"verified_provider": {"type": "boolean"}, "rating_average": {"type": "number", "minimum": 0, "maximum": 5}, "completed_bookings": {"type": "integer", "minimum": 0}}},
      "ServiceCollectionItem": {"type": "object", "additionalProperties": false, "required": ["service_id", "provider_id", "title", "summary", "media", "price", "price_display", "serviceable", "trust", "navigation_target"], "properties": {"service_id": {"type": "string", "maxLength": 128}, "provider_id": {"type": "string", "maxLength": 128}, "title": {"type": "string", "minLength": 1, "maxLength": 120}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}, "media": {"oneOf": [{"$ref": "#/components/schemas/MediaPresentation"}, {"type": "null"}]}, "price": {"$ref": "#/components/schemas/Money"}, "price_display": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Server-owned localized price display"}, "serviceable": {"type": "boolean"}, "trust": {"$ref": "#/components/schemas/ServiceTrustSummary"}, "navigation_target": {"type": "string", "pattern": "^/app/services/[A-Za-z0-9._:-]+$"}}},
      "ServiceCollection": {"type": "object", "additionalProperties": false, "required": ["collection_id", "title", "items"], "properties": {"collection_id": {"type": "string", "maxLength": 128}, "title": {"type": "string", "minLength": 1, "maxLength": 120}, "items": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/components/schemas/ServiceCollectionItem"}}}},
      "Home": {"type": "object", "additionalProperties": false, "required": ["categories", "featured_items", "recommendations", "leaderboard", "help_shortcuts", "service_collections", "projection_status", "generated_at"], "properties": {"categories": {"type": "array", "items": {"$ref": "#/components/schemas/Category"}}, "featured_items": {"type": "array", "items": {"$ref": "#/components/schemas/Item"}}, "recommendations": {"type": "array", "items": {"$ref": "#/components/schemas/Item"}}, "leaderboard": {"type": "array", "items": {"$ref": "#/components/schemas/SellerLeader"}}, "help_shortcuts": {"type": "array", "items": {"$ref": "#/components/schemas/HelpShortcut"}}, "service_collections": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/ServiceCollection"}}, "projection_status": {"$ref": "#/components/schemas/ProjectionStatus"}, "generated_at": {"type": "string", "format": "date-time"}}},
      "GeoPoint": {"type": "object", "additionalProperties": false, "required": ["latitude", "longitude", "accuracy_metres", "captured_at", "purpose"], "properties": {"latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "accuracy_metres": {"type": "number", "minimum": 0}, "captured_at": {"type": "string", "format": "date-time"}, "purpose": {"type": "string", "const": "LOCATION_SERVICEABILITY"}}},
      "Serviceability": {"type": "object", "additionalProperties": false, "required": ["serviceable", "reason_code"], "properties": {"serviceable": {"type": "boolean"}, "zone_id": {"type": "string"}, "locality": {"type": "string"}, "reason_code": {"type": "string"}}},
      "GeocodeCandidate": {"type": "object", "additionalProperties": false, "required": ["id", "label", "locality", "postal_code", "latitude", "longitude"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "locality": {"type": "string"}, "postal_code": {"type": "string"}, "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}}},
      "Suggestion": {"type": "object", "additionalProperties": false, "required": ["type", "id", "label"], "properties": {"type": {"type": "string", "enum": ["TRENDING", "PRODUCT", "VENDOR", "TAG"]}, "id": {"type": "string"}, "label": {"type": "string"}, "subtitle": {"type": "string"}, "item_id": {"type": "string"}}}
    }
  },
  "x-planext4u-owner": "catalog-discovery-and-edge-bff",
  "x-planext4u-reviewers": ["product", "security", "privacy"],
  "x-planext4u-classification": "internal-with-consented-location",
  "x-planext4u-slo-class": "critical"
}
