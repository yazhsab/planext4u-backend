{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 16,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ItemID": {
        "in": "path",
        "name": "item_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "VendorID": {
        "in": "path",
        "name": "vendor_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ApplicationStatus": {
        "enum": [
          "REGISTERED",
          "DOCUMENTS_SUBMITTED",
          "OCR_REVIEW",
          "KYC_REVIEW",
          "FIELD_VISIT_REQUIRED",
          "FIELD_VISIT_SCHEDULED",
          "FIELD_VISIT_PASSED",
          "BANK_REVIEW",
          "APPROVED",
          "REJECTED"
        ],
        "type": "string"
      },
      "BankAccount": {
        "additionalProperties": false,
        "properties": {
          "holder_name": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "ifsc": {
            "type": "string"
          },
          "last4": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "reference",
          "holder_name",
          "last4",
          "ifsc",
          "status"
        ],
        "type": "object"
      },
      "CatalogKind": {
        "enum": [
          "PRODUCT",
          "SERVICE",
          "FOOD"
        ],
        "type": "string"
      },
      "Dashboard": {
        "additionalProperties": false,
        "properties": {
          "application": {
            "$ref": "#/components/schemas/VendorApplication"
          },
          "catalog_items": {
            "type": "integer"
          },
          "low_stock_items": {
            "type": "integer"
          },
          "offline_snapshot_at": {
            "format": "date-time",
            "type": "string"
          },
          "open_work_items": {
            "type": "integer"
          },
          "points": {
            "type": "integer"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sales": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "application",
          "catalog_items",
          "low_stock_items",
          "offline_snapshot_at",
          "open_work_items",
          "points",
          "recommendations",
          "sales"
        ],
        "type": "object"
      },
      "FieldVisit": {
        "additionalProperties": false,
        "properties": {
          "allowed_radius_m": {
            "type": "number"
          },
          "check_in_distance_m": {
            "type": "number"
          },
          "checked_in_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "officer_id": {
            "type": "string"
          },
          "scheduled_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "allowed_radius_m",
          "id",
          "latitude",
          "longitude",
          "scheduled_at"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ],
        "type": "object"
      },
      "Promotion": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Money"
          },
          "conversions": {
            "type": "integer"
          },
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "impressions": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "vendor_id": {
            "type": "string"
          }
        },
        "required": [
          "budget",
          "conversions",
          "ends_at",
          "id",
          "impressions",
          "kind",
          "starts_at",
          "status",
          "title",
          "vendor_id"
        ],
        "type": "object"
      },
      "ScheduleWindow": {
        "additionalProperties": false,
        "properties": {
          "buffer_minutes": {
            "type": "integer"
          },
          "capacity": {
            "type": "integer"
          },
          "ends_minute": {
            "type": "integer"
          },
          "starts_minute": {
            "type": "integer"
          },
          "time_zone": {
            "type": "string"
          },
          "weekday": {
            "type": "integer"
          }
        },
        "required": [
          "buffer_minutes",
          "capacity",
          "ends_minute",
          "starts_minute",
          "time_zone",
          "weekday"
        ],
        "type": "object"
      },
      "ServiceZone": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "policy_version": {
            "type": "string"
          },
          "postal_codes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "radius_km": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "latitude",
          "longitude",
          "policy_version",
          "postal_codes",
          "radius_km"
        ],
        "type": "object"
      },
      "TimelineEvent": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          }
        },
        "required": [
          "actor",
          "created_at",
          "status"
        ],
        "type": "object"
      },
      "VendorApplication": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "bank_account": {
            "$ref": "#/components/schemas/BankAccount",
            "anyOf": [
              {
                "$ref": "#/components/schemas/BankAccount"
              },
              {
                "type": "null"
              }
            ]
          },
          "business_name": {
            "type": "string"
          },
          "business_type": {
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/VendorDocument"
            },
            "type": "array"
          },
          "field_visit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FieldVisit"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          },
          "service_zones": {
            "items": {
              "$ref": "#/components/schemas/ServiceZone"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineEvent"
            },
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "vendor_id": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "vendor_id",
          "revision",
          "status",
          "business_name",
          "documents",
          "service_zones",
          "verified",
          "timeline",
          "created_at",
          "updated_at",
          "allowed_actions",
          "business_type",
          "contact_name"
        ],
        "type": "object"
      },
      "VendorCatalogItem": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "approval_status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CatalogKind"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "revision": {
            "type": "integer"
          },
          "schedules": {
            "items": {
              "$ref": "#/components/schemas/ScheduleWindow"
            },
            "type": "array"
          },
          "sku": {
            "type": "string"
          },
          "stock": {
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "vendor_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "vendor_id",
          "revision",
          "kind",
          "name",
          "price",
          "stock",
          "approval_status",
          "active",
          "schedules",
          "updated_at",
          "allowed_actions",
          "description",
          "sku"
        ],
        "type": "object"
      },
      "VendorDocument": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "extracted_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "x-planext4u-sensitive": true
          },
          "kind": {
            "type": "string"
          },
          "ocr_status": {
            "type": "string"
          },
          "review_reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "asset_id",
          "ocr_status"
        ],
        "type": "object"
      },
      "WorkItem": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "customer_label": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "reference_id": {
            "type": "string"
          },
          "reference_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "vendor_id": {
            "type": "string"
          }
        },
        "required": [
          "allowed_actions",
          "customer_label",
          "id",
          "reference_id",
          "reference_type",
          "status",
          "total",
          "updated_at",
          "vendor_id"
        ],
        "type": "object"
      },
      "ApproveVendorCatalogRequest": {
        "additionalProperties": false,
        "properties": {
          "approved": {
            "type": "boolean"
          },
          "reason": {
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "approved",
          "reason"
        ],
        "type": "object"
      },
      "CheckInVendorFieldVisitRequest": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object"
      },
      "CreateVendorPromotionRequest": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Money"
          },
          "ends_at": {
            "format": "date-time",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "budget",
          "ends_at",
          "kind",
          "starts_at",
          "title"
        ],
        "type": "object"
      },
      "RegisterVendorRequest": {
        "additionalProperties": false,
        "properties": {
          "business_name": {
            "type": "string"
          },
          "business_type": {
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          }
        },
        "required": [
          "business_name",
          "business_type",
          "contact_name"
        ],
        "type": "object"
      },
      "ScheduleVendorFieldVisitRequest": {
        "additionalProperties": false,
        "properties": {
          "allowed_radius_m": {
            "maximum": 2000,
            "minimum": 20,
            "type": "number"
          },
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          "scheduled_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "allowed_radius_m",
          "latitude",
          "longitude",
          "scheduled_at"
        ],
        "type": "object"
      },
      "SetVendorInventoryRequest": {
        "additionalProperties": false,
        "properties": {
          "stock": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "stock"
        ],
        "type": "object"
      },
      "SetVendorScheduleRequest": {
        "additionalProperties": false,
        "properties": {
          "windows": {
            "items": {
              "$ref": "#/components/schemas/ScheduleWindow"
            },
            "type": "array"
          }
        },
        "required": [
          "windows"
        ],
        "type": "object"
      },
      "SetVendorZonesRequest": {
        "additionalProperties": false,
        "properties": {
          "zones": {
            "items": {
              "$ref": "#/components/schemas/ServiceZone"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "zones"
        ],
        "type": "object"
      },
      "SubmitVendorBankRequest": {
        "additionalProperties": false,
        "properties": {
          "holder_name": {
            "minLength": 3,
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "ifsc": {
            "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$",
            "type": "string"
          },
          "last4": {
            "pattern": "^[0-9]{4}$",
            "type": "string"
          },
          "reference": {
            "pattern": "^bankref_[A-Za-z0-9_-]{8,100}$",
            "type": "string",
            "x-planext4u-sensitive": true
          }
        },
        "required": [
          "holder_name",
          "ifsc",
          "last4",
          "reference"
        ],
        "type": "object"
      },
      "SubmitVendorDocumentsRequest": {
        "additionalProperties": false,
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/SubmitVendorDocumentRequest"
            },
            "maxItems": 10,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": [
          "documents"
        ],
        "type": "object"
      },
      "SubmitVendorDocumentRequest": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "x-planext4u-sensitive": true
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "asset_id",
          "kind"
        ],
        "type": "object"
      },
      "TransitionVendorApplicationRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 8,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          }
        },
        "required": [
          "reason",
          "status"
        ],
        "type": "object"
      },
      "TransitionVendorWorkRequest": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "UpsertVendorCatalogItemRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CatalogKind"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "sku": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "kind",
          "name",
          "price",
          "sku"
        ],
        "type": "object"
      },
      "VerifyVendorBankRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Supply API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/vendor/application": {
      "get": {
        "operationId": "getVendorApplication",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApplication"
                }
              }
            },
            "description": "Application"
          }
        }
      }
    },
    "/v1/vendor/application/bank": {
      "post": {
        "operationId": "submitVendorBank",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitVendorBankRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApplication"
                }
              }
            },
            "description": "Bank submitted"
          }
        }
      }
    },
    "/v1/vendor/application/documents": {
      "post": {
        "operationId": "submitVendorDocuments",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitVendorDocumentsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApplication"
                }
              }
            },
            "description": "Documents submitted"
          }
        }
      }
    },
    "/v1/vendor/application/field-visit": {
      "post": {
        "operationId": "scheduleVendorFieldVisit",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleVendorFieldVisitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApplication"
                }
              }
            },
            "description": "Visit scheduled"
          }
        }
      }
    },
    "/v1/vendor/application/zones": {
      "post": {
        "operationId": "setVendorZones",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetVendorZonesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApplication"
                }
              }
            },
            "description": "Zones stored"
          }
        }
      }
    },
    "/v1/vendor/applications": {
      "post": {
        "operationId": "registerVendor",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterVendorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApplication"
                }
              }
            },
            "description": "Registered"
          }
        }
      }
    },
    "/v1/vendor/applications/{vendor_id}/bank-verification": {
      "post": {
        "operationId": "verifyVendorBank",
        "parameters": [
