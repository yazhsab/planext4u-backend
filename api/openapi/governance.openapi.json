{
  "components": {
    "schemas": {
      "CountryControl": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "feature_flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object"
          },
          "locales": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "policy_version": {
            "type": "string"
          }
        },
        "required": [
          "country",
          "currency",
          "feature_flags",
          "locales",
          "policy_version"
        ],
        "type": "object"
      },
      "Dashboard": {
        "additionalProperties": false,
        "properties": {
          "countries": {
            "items": {
              "$ref": "#/components/schemas/CountryControl"
            },
            "type": "array"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "insights": {
            "items": {
              "$ref": "#/components/schemas/GovernanceInsight"
            },
            "type": "array"
          },
          "leaderboard": {
            "items": {
              "$ref": "#/components/schemas/GovernanceLeaderboardEntry"
            },
            "type": "array"
          },
          "map_cells": {
            "items": {
              "$ref": "#/components/schemas/GovernanceMapCell"
            },
            "type": "array"
          },
          "privacy_mode": {
            "type": "string"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/GovernanceReport"
            },
            "type": "array"
          }
        },
        "required": [
          "countries",
          "generated_at",
          "insights",
          "leaderboard",
          "map_cells",
          "privacy_mode",
          "reports"
        ],
        "type": "object"
      },
      "GovernanceInsight": {
        "properties": {
          "confidence": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "type": "string"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "confidence",
          "evidence",
          "generated_at"
        ],
        "type": "object"
      },
      "GovernanceLeaderboardEntry": {
        "properties": {
          "badge": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "pii_masked": {
            "type": "boolean"
          },
          "rank": {
            "type": "integer"
          },
          "score": {
            "type": "integer"
          }
        },
        "required": [
          "rank",
          "label",
          "score",
          "badge",
          "pii_masked"
        ],
        "type": "object"
      },
      "GovernanceMapCell": {
        "properties": {
          "count": {
            "type": "integer"
          },
          "intensity": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "precision": {
            "enum": [
              "aggregate_region"
            ],
            "type": "string"
          },
          "region_code": {
            "type": "string"
          }
        },
        "required": [
          "region_code",
          "label",
          "count",
          "intensity",
          "precision"
        ],
        "type": "object"
      },
      "GovernanceReport": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "export_policy": {
            "enum": [
              "MFA_AND_AUDIT_REQUIRED"
            ],
            "type": "string"
          },
          "freshness": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "masked": {
            "type": "boolean"
          },
          "metric": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "domain",
          "metric",
          "value",
          "unit",
          "freshness",
          "masked",
          "export_policy"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Planext4u Governance and Intelligence API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/governance/countries": {
      "get": {
        "operationId": "listGovernanceCountries",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "generated_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/CountryControl"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "generated_at",
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Authorized country configuration"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/governance/dashboard": {
      "get": {
        "operationId": "getGovernanceDashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            },
            "description": "Country-scoped governance dashboard"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/governance/intelligence": {
      "get": {
        "operationId": "getGovernanceIntelligence",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "generated_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/GovernanceInsight"
                      },
                      "type": "array"
                    },
                    "privacy_mode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "generated_at",
                    "items",
                    "privacy_mode"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Evidence-labelled insights"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/governance/leaderboards": {
      "get": {
        "operationId": "getGovernanceLeaderboards",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "generated_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/GovernanceLeaderboardEntry"
                      },
                      "type": "array"
                    },
                    "privacy_mode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "generated_at",
                    "items",
                    "privacy_mode"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "PII-masked rankings"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/governance/maps": {
      "get": {
        "operationId": "getGovernanceMaps",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "generated_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/GovernanceMapCell"
                      },
                      "type": "array"
                    },
                    "privacy_mode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "generated_at",
                    "items",
                    "privacy_mode"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Aggregate-region heatmap cells"
          }
        },
        "x-planext4u-mfa-required": true
      }
    },
    "/v1/governance/reports": {
      "get": {
        "operationId": "listGovernanceReports",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "generated_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/GovernanceReport"
                      },
                      "type": "array"
                    },
                    "privacy_mode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "generated_at",
                    "items",
                    "privacy_mode"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Masked operational and finance reports"
          }
        },
        "x-planext4u-mfa-required": true
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-planext4u-reviewers": [
    "architecture",
    "security",
    "privacy",
    "finance",
    "operations"
  ]
}
