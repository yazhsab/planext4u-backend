  "paths": {
    "/v1/dispatch/stale-assignment-sweep": {
      "post": {
        "operationId": "sweepStaleAssignments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "flagged": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "flagged"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Swept"
          }
        }
      }
    },
