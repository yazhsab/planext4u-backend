{
  "openapi":"3.1.0",
  "info":{"title":"Planext4u Fulfillment API","version":"1.0.0"},
  "x-planext4u-reviewers":["architecture","security","privacy","finance","mobile"],
  "security":[{"bearerAuth":[]}],
  "paths":{
    "/v1/rider/applications":{"post":{"operationId":"registerRider","responses":{"201":{"description":"Registered"}}}},
    "/v1/rider/profile":{"get":{"operationId":"getRiderProfile","responses":{"200":{"description":"Profile"}}}},
    "/v1/rider/applications/{rider_id}/review":{"post":{"operationId":"reviewRider","responses":{"200":{"description":"Reviewed"}}}},
    "/v1/rider/duty/start":{"post":{"operationId":"startRiderDuty","responses":{"201":{"description":"Duty started"}}}},
    "/v1/rider/duty":{"get":{"operationId":"getRiderDuty","responses":{"200":{"description":"Duty"}}}},
    "/v1/rider/duty/end":{"post":{"operationId":"endRiderDuty","responses":{"200":{"description":"Duty ended"}}}},
    "/v1/rider/offers":{"get":{"operationId":"listRiderOffers","responses":{"200":{"description":"Offers"}}}},
    "/v1/rider/tasks":{"get":{"operationId":"listRiderTasks","responses":{"200":{"description":"Tasks"}}}},
    "/v1/rider/tasks/{task_id}/accept":{"post":{"operationId":"acceptRiderOffer","responses":{"200":{"description":"Accepted"}}}},
    "/v1/rider/tasks/{task_id}/pickup":{"post":{"operationId":"markRiderPickup","responses":{"200":{"description":"Picked up"}}}},
    "/v1/rider/tasks/{task_id}/completion":{"post":{"operationId":"completeRiderDelivery","responses":{"200":{"description":"Delivered"}}}},
    "/v1/rider/location":{"post":{"operationId":"updateRiderLocation","responses":{"200":{"description":"Location updated"}}}},
    "/v1/rider/locations/{rider_id}":{"get":{"operationId":"getRiderLocation","responses":{"200":{"description":"Location"}}}},
    "/v1/rider/offline-recovery":{"post":{"operationId":"recoverRiderOfflineCommands","responses":{"200":{"description":"Recovered"}}}},
    "/v1/dispatch/tasks":{"post":{"operationId":"createDispatchTask","responses":{"201":{"description":"Task created"}}}},
    "/v1/dispatch/tasks/{task_id}/offer":{"post":{"operationId":"offerDispatchTask","responses":{"200":{"description":"Offered"}}}},
    "/v1/dispatch/tasks/{task_id}/reassign":{"post":{"operationId":"reassignDispatchTask","responses":{"200":{"description":"Reassigned"}}}},
    "/v1/dispatch/stale-assignment-sweep":{"post":{"operationId":"sweepStaleAssignments","responses":{"200":{"description":"Swept"}}}},
    "/v1/order-chats/{order_id}":{"get":{"operationId":"getOrderChat","responses":{"200":{"description":"Conversation"}}}},
    "/v1/order-chats/{conversation_id}/messages":{"post":{"operationId":"sendOrderChatMessage","responses":{"201":{"description":"Message"}}}},
    "/v1/order-chats/{conversation_id}/messages/{message_id}/receipts":{"post":{"operationId":"recordOrderChatReceipt","responses":{"200":{"description":"Receipt"}}}},
    "/v1/order-chats/{conversation_id}/block":{"post":{"operationId":"blockOrderChat","responses":{"200":{"description":"Blocked"}}}},
    "/v1/settlements/ledger":{"get":{"operationId":"listSettlementLedger","responses":{"200":{"description":"Ledger"}}}},
    "/v1/settlements/seed":{"post":{"operationId":"seedSettlementEntry","responses":{"201":{"description":"Entry"}}}},
    "/v1/payouts":{"get":{"operationId":"listPayouts","responses":{"200":{"description":"Payouts"}}},"post":{"operationId":"requestPayout","responses":{"201":{"description":"Payout"}}}},
    "/v1/payouts/{payout_id}/approve":{"post":{"operationId":"approvePayout","responses":{"200":{"description":"Approved"}}}},
    "/v1/payouts/{payout_id}/execute":{"post":{"operationId":"executePayout","responses":{"200":{"description":"Executed"}}}},
    "/v1/settlements/reconciliation":{"get":{"operationId":"reconcileSettlement","responses":{"200":{"description":"Reconciliation"}}}},
    "/v1/operations/territories":{"get":{"operationId":"listTerritories","responses":{"200":{"description":"Territories"}}}},
    "/v1/operations/territories/{territory_id}/field-check-in":{"post":{"operationId":"recordFieldCheckIn","responses":{"201":{"description":"Check-in"}}}},
    "/v1/operations/attendance":{"get":{"operationId":"listAttendance","responses":{"200":{"description":"Attendance"}}}},
    "/v1/operations/regions/{region_id}/dashboard":{"get":{"operationId":"getRegionalDashboard","responses":{"200":{"description":"Dashboard"}}}},
    "/v1/operations/audit":{"get":{"operationId":"listFulfillmentAudit","responses":{"200":{"description":"Audit"}}}}
  },
  "components":{
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "schemas":{
      "RiderStatus":{"type":"string","enum":["REGISTERED","KYC_REVIEW","APPROVED","SUSPENDED"]},
      "DeliveryStatus":{"type":"string","enum":["READY_FOR_DISPATCH","OFFERED","ASSIGNED","PICKED_UP","DELIVERED","REASSIGNMENT_REQUIRED"]},
      "PayoutStatus":{"type":"string","enum":["PENDING_REVIEW","FIRST_APPROVED","APPROVED","FAILED","PAID"]},
      "RiderProfile":{"type":"object","required":["id","rider_id","revision","status","full_name","phone_masked","vehicle_type","documents","bank_status","zones","max_concurrent","created_at","updated_at"],"properties":{"id":{"type":"string"},"rider_id":{"type":"string"},"revision":{"type":"integer"},"status":{"$ref":"#/components/schemas/RiderStatus"},"full_name":{"type":"string"},"phone_masked":{"type":"string"},"vehicle_type":{"type":"string"},"documents":{"type":"array","items":{"type":"object"},"x-planext4u-sensitive":true},"bank_reference":{"type":"string","x-planext4u-sensitive":true},"bank_status":{"type":"string"},"zones":{"type":"array","items":{"type":"string"}},"max_concurrent":{"type":"integer"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
      "DeliveryTask":{"type":"object","required":["id","revision","order_id","order_type","region_id","territory_id","zone_id","status","pickup","dropoff","distance_meters","earning","updated_at"],"properties":{"id":{"type":"string"},"revision":{"type":"integer"},"order_id":{"type":"string"},"order_type":{"type":"string"},"region_id":{"type":"string"},"territory_id":{"type":"string"},"zone_id":{"type":"string"},"status":{"$ref":"#/components/schemas/DeliveryStatus"},"pickup":{"type":"object"},"dropoff":{"type":"object"},"distance_meters":{"type":"integer"},"earning":{"type":"object"},"pod_blurred_asset_id":{"type":"string","x-planext4u-sensitive":true},"pod_signature_asset_id":{"type":"string","x-planext4u-sensitive":true},"updated_at":{"type":"string","format":"date-time"}}},
      "DeliveryCompletionRequest":{"type":"object","required":["blurred_photo_asset_id"],"properties":{"otp":{"type":"string","writeOnly":true,"x-planext4u-sensitive":true},"blurred_photo_asset_id":{"type":"string","x-planext4u-sensitive":true},"signature_asset_id":{"type":"string","x-planext4u-sensitive":true}},"additionalProperties":false},
      "Conversation":{"type":"object","required":["id","order_id","participant_ids","expires_at","blocked","messages"],"properties":{"id":{"type":"string"},"order_id":{"type":"string"},"participant_ids":{"type":"array","items":{"type":"string"}},"expires_at":{"type":"string","format":"date-time"},"blocked":{"type":"boolean"},"messages":{"type":"array","items":{"$ref":"#/components/schemas/ChatMessage"}}}},
      "ChatMessage":{"type":"object","required":["id","sender_id","body","redacted","created_at","receipts"],"properties":{"id":{"type":"string"},"sender_id":{"type":"string"},"body":{"type":"string"},"redacted":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"receipts":{"type":"array","items":{"type":"object"}}}},
      "LedgerEntry":{"type":"object","required":["id","account_id","reference_id","kind","gross","commission","tax","net","calculation_version","available_at","created_at"],"properties":{"id":{"type":"string"},"account_id":{"type":"string"},"reference_id":{"type":"string"},"kind":{"type":"string"},"gross":{"type":"object"},"commission":{"type":"object"},"tax":{"type":"object"},"net":{"type":"object"},"calculation_version":{"type":"string"},"available_at":{"type":"string","format":"date-time"},"created_at":{"type":"string","format":"date-time"}}},
      "Payout":{"type":"object","required":["id","account_id","revision","amount","status","entry_ids","attempt_count","created_at","updated_at"],"properties":{"id":{"type":"string"},"account_id":{"type":"string"},"revision":{"type":"integer"},"amount":{"type":"object"},"status":{"$ref":"#/components/schemas/PayoutStatus"},"entry_ids":{"type":"array","items":{"type":"string"}},"first_approver_id":{"type":"string"},"second_approver_id":{"type":"string"},"provider_reference":{"type":"string","x-planext4u-sensitive":true},"attempt_count":{"type":"integer"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
    }
  }
}
